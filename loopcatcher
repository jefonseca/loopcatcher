#!/bin/bash
###############################################################################
# loopcatcher - record app/system loopback audio to AAC or OGG files.
#
# Flow: Welcome (main menu) -> Session Name -> Recording Wizard (3 steps)
#       -> Recording screen -> Finish. The session ends automatically when
#       playback pauses, stops, or the player quits.
#
# The Welcome/Settings/Session Name/Finish screens and the encoding/output
# engine below are fixed and profile-independent. Everything about detecting
# and monitoring a specific player lives in a loadable "profile module" (see
# the "Profile modules" section) - profiles/<name>/profile.sh, sourced by
# load_profile_module(). Only one module ships today: profiles/spotify_native.
#
# Every user-facing string is looked up through t() (see "i18n" below) from a
# catalog sourced once at startup - nothing reloads mid-session (see "Config
# file"/"Main" below): edits save to disk immediately but the running process
# keeps whatever it read at launch until the user picks "Apply configuration
# change" from the Welcome menu (a plain "exec $0") - which only appears once
# something has actually changed this run (config_changed).
###############################################################################

set -u
set -o pipefail

if [[ $EUID -eq 0 ]]; then
    echo "This script must not be run as root"
    exit 1
fi

###############################################################################
# Constants
###############################################################################

# gum styling rules for the whole UI: fixed total rendered width 100
# (UI_WIDTH), everywhere. "gum style --width N" sets N as CONTENT width and
# adds its own border on top (+2 total, verified for every border style this
# app uses: normal/rounded/thick/double all add exactly 1 column per side) -
# every constant below already subtracts that border (and, where present,
# margin) so the box/table/row's ACTUAL rendered footprint is exactly
# UI_WIDTH. Never pass UI_WIDTH straight to --width on a bordered element.
UI_WIDTH=100

# Cursor/prompt marker used on every interactive gum widget in the app: the
# --cursor on every "gum choose", the --prompt on every "gum input", and (new)
# the --prompt on "gum filter" (Change Profile - see ELEMENT TYPES below).
UI_CURSOR="👉 "

# Content width for a single-border element meant to span the full TUI width
# (border adds 2) - used by ui_box, and by ui_title() when shown alone
# (border 2, no margin: UI_WIDTH - 2).
UI_BOX_CONTENT_WIDTH=$((UI_WIDTH - 2))
# Usable text width inside a Normal element, e.g. ui_subtitle nested in a
# Wizard step (ui_box's own border 2 already removed above; its padding
# "1 10" removes 20 more).
UI_INNER_WIDTH=$((UI_BOX_CONTENT_WIDTH - 20))

# Column widths for every "Field / Value" gum table (ui_kv_table). gum table's
# own --widths flag has no effect in --print (static) mode - confirmed by
# testing, it only matters for the interactive/live table - so ui_kv_table
# pads every field to a fixed width itself before gum ever sees it. Measured
# empirically: a 2-column "gum table --border rounded" then renders at exactly
# label + value + 7 columns wide (borders + separator + each cell's own
# leading/trailing space), so this makes the whole table exactly UI_WIDTH.
UI_TABLE_LABEL_WIDTH=18
UI_TABLE_VALUE_WIDTH=$((UI_WIDTH - UI_TABLE_LABEL_WIDTH - 7))

# The Cancel hint sits to the right of the Title Bar (see ui_title_row), each
# in its own bordered box (+2 each, so -4 total). Its column is a fixed
# content width; the Title Bar box takes what's left, so the joined row is
# exactly UI_WIDTH wide.
UI_HINT_WIDTH=36
UI_TITLE_ROW_WIDTH=$((UI_WIDTH - 4 - UI_HINT_WIDTH))

# Notification content width: same as a Normal element (border 2, no
# horizontal margin) so it lines up with every other element's total width.
UI_NOTIFY_WIDTH=$UI_BOX_CONTENT_WIDTH

# Keep gum styling (bold, borders) when its stdout is a pipe - the nested
# $(gum style ...) fragments composed for a screen frame need this.
export CLICOLOR_FORCE=1

###############################################################################
# i18n
#
# One pair of associative arrays, MSG_en/MSG_es, keyed by dotted message id,
# populated one FILE PER LANGUAGE (lang/en.sh, lang/es.sh, ...) rather than
# one combined file - a translator only ever touches their own language's
# file. `load_lang_dir <dir>` always sources <dir>/en.sh first (the fallback
# baseline every id must exist in) then, if a different language is active,
# <dir>/$language.sh on top of it as an overlay - only the ids that file
# actually defines get added/overridden, so a translation can lag behind
# English on newly-added ids without breaking (t() falls back to English for
# anything missing). Used both for this script's own catalog (lang_root) and
# for each profile module's own catalog (see "Profile modules" below, and
# profiles/spotify_native/lang/ for a worked example). t() is the one lookup
# function, used by the main script and every module alike.
#
# lang_root()'s directory is sourced here, at the very top of the script's
# top-level body (using whatever $language detect_system_language() lands on
# - the persisted config value, if different, is applied by a second
# load_lang_dir call inside load_config() once it's known), so even the
# earliest possible diagnostic (check_dependencies, before main()'s own
# screens run) can call t(). --help/--version and early dependency FATALs can
# therefore only ever reflect the auto-detected system language, never a
# saved-but-not-yet-loaded config preference - an accepted trade-off of not
# loading every language "just in case".
###############################################################################

lang_root () {
    local script_dir
    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    if [[ -d "$script_dir/lang" ]]; then
        printf '%s\n' "$script_dir/lang"
    else
        printf '%s\n' "/usr/share/loopcatcher/lang"
    fi
}

# t <message-id> [printf-args...] - looks up $effective_language's entry for
# the id, falling back to English, then to the raw id itself (visibly broken
# rather than silently empty - easy to grep for). Always ends with exactly
# one trailing newline; every call site that composes a larger string wraps
# it in "$(...)" anyway, which strips that back out, so this only actually
# matters for the couple of call sites that print directly, uncaptured.
t () {
    local id="$1"; shift
    local fmt=""
    # Only two languages exist, so this stays a plain if instead of building
    # a nameref indirection off $effective_language - which would also have
    # to guard against it ever being something other than "en"/"es", since a
    # nameref to a never-declared array silently falls back to treating
    # [$id] as an arithmetic subscript instead of a string one, breaking on
    # any dotted id. The same failure mode applies to MSG_es/MSG_en
    # themselves if their file was never loaded (a corrupted/partial install
    # missing lang/es.sh, say) - "[[ -v MSG_es ]]" doesn't reliably detect an
    # associative array's existence in this bash version (only elements), so
    # "declare -p ... &>/dev/null" is the check that's actually safe here.
    # shellcheck disable=SC2154  # MSG_es/MSG_en are declared by lang/*.sh, sourced dynamically by load_lang_dir()
    if [[ "$effective_language" == "es" ]] && declare -p MSG_es &>/dev/null; then
        fmt="${MSG_es[$id]:-}"
    fi
    # shellcheck disable=SC2154  # MSG_en is declared by lang/en.sh, sourced dynamically by load_lang_dir()
    if [[ -z "$fmt" ]] && declare -p MSG_en &>/dev/null; then
        fmt="${MSG_en[$id]:-}"
    fi
    [[ -n "$fmt" ]] || fmt="$id"
    if [[ $# -gt 0 ]]; then
        # shellcheck disable=SC2059  # $fmt IS the format string by design - it's a catalog entry with %s placeholders, not user input
        printf -- "$fmt\n" "$@"
    else
        printf '%s\n' "$fmt"
    fi
}

# es* -> es, anything else -> en. Checked in the same priority glibc uses.
detect_system_language () {
    local loc="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
    case "$loc" in
        es*) printf 'es' ;;
        *)   printf 'en' ;;
    esac
}

# Resolves the persisted "language" setting ("auto"/"en"/"es") into the
# concrete "en"/"es" value t()/load_lang_dir() actually use. "auto" re-detects
# from the system locale every time this runs, rather than once and freezing
# the result into $effective_language forever - so picking "auto" after
# having explicitly set a language, then Applying the change, genuinely goes
# back to following the system locale, including a future locale change.
resolve_language () {
    if [[ "$language" == "auto" ]]; then
        detect_system_language
    else
        printf '%s' "$language"
    fi
}

# See the banner above: <dir>/en.sh always, <dir>/$effective_language.sh on
# top if different and present. Safe to call more than once (e.g. once early
# with the just-resolved language, again from load_config() once the
# persisted value is known and re-resolved) - re-sourcing the same file just
# re-populates the same array entries.
load_lang_dir () {
    local dir="$1"
    # shellcheck disable=SC1090,SC1091
    [[ -r "$dir/en.sh" ]] && source "$dir/en.sh"
    if [[ "$effective_language" != "en" && -r "$dir/$effective_language.sh" ]]; then
        # shellcheck disable=SC1090,SC1091
        source "$dir/$effective_language.sh"
    fi
}

# "auto"/"en"/"es" (persisted) and its "en"/"es" resolution (runtime-only,
# never persisted - see resolve_language()). Defaulting to "auto" here (ahead
# of Global State so load_lang_dir has a value to work with) means a fresh
# install always starts by following the system locale, exactly like an
# explicit "auto" choice does later - both are set once load_config() runs.
language="auto"
effective_language="$(resolve_language)"
load_lang_dir "$(lang_root)"

###############################################################################
# Global state
###############################################################################

# --- persisted to the config file ---
# 0 = no log written at all, 1 = normal session log, 2 = adds encoder diagnostics.
log_level="0"
# Directory name (under profiles/) of the active profile module.
default_profile="spotify_native"
# Space-separated module directory names allowed to be used anywhere.
# default_profile's own module is always implicitly included.
enabled_profiles=""
nulloutput_name="loopcatcher"
aac_profile="29"
bitrate="48"
record_format="aac"
filename_scheme="normal"
output_directory=""
# Extra capture time (seconds) kept running after the player reports pause/stop
# so the audio tail still in the sink -> parec -> pipe -> encoder chain is
# written instead of cut. Trade-off: up to this much near-silence at the end of
# the last track. 0 disables it.
tail_drain_seconds="0.35"
# Absolute path of the session log file. Empty means the default:
# "${TMPDIR:-/tmp}/loopcatcher/<session-name>.log" (see effective_log_file_path).
log_file_path=""
# "auto"/"en"/"es" - already set above (before Constants/i18n sourcing needed
# it); repeated here only as a reminder of where it lives among the other
# persisted keys. Overwritten by the config file's own value if it has one -
# see resolve_language()/effective_language for what actually drives t().

# --- CLI / lifecycle ---
show_help=false
show_version=false
should_exit=0
exit_note=""
# Not persisted, session-only: true once any Settings/Profile Settings field
# has actually been saved this run. Gates whether Welcome offers "Apply
# configuration change" - see welcome_screen().
config_changed=false

# --- live status view ---
status_dirty=0             # main loop repaints once per tick only when this is set
_spinner_pid=""             # backgrounded "gum spin" decorating the Recording screen
recording_failed=false     # Catcher Status: false -> "Recording", true -> "Failed"
session_ended=false        # set by end_session(); tells main() to show the Finish screen
tui_track="-"
tui_artist="-"
tui_album="-"
tui_tracknumber="-"
tui_discnumber="-"
tui_output="-"

# --- session ---
session_name=""
session_output_directory=""
session_log_path=""

# --- sink routing ---
source_sink_index=""

# --- generic, unprefixed runtime vars populated by the active profile
# module's profile_activate() (see "Profile modules" below). Read by the
# generic sink-detection/routing functions further down, and by whatever the
# active module's own internal functions need them for.
sink_app_name=""
# shellcheck disable=SC2034  # read by the active profile module (e.g. spotify_native's MPRIS calls), not by this file
player_mpris_bus=""
player_sink_match=""

# Every extra artist value a profile module's monitor collects for a track
# (start_recording, generic, uses this for OGG's multi-ARTIST= tagging) -
# declared here, not in the module, so start_recording never dereferences an
# unset array under "set -u" when no module has populated it yet.
artist_all=()

# --- recording engine ---
parec_pid=""
encoder_pid=""
record_fifo_dir=""
record_error_log=""
stopping_recording=false
# Metadata + start time of the in-flight recording, set by start_recording and
# consumed (then cleared) by stop_current_recording once it actually stops, so
# the session log gets the real capture duration alongside the metadata.
record_start_seconds=0
record_log_artist=""
record_log_album=""
record_log_title=""
record_log_tracknumber=""
record_log_discnumber=""
record_log_file=""

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$XDG_CONFIG_HOME/loopcatcher"
config_path="$config_dir/config"

get_script_version () {
    local script_dir version_file file_version
    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    for version_file in "$script_dir/VERSION" "/usr/share/loopcatcher/VERSION"; do
        if [[ -r "$version_file" ]]; then
            IFS= read -r file_version < "$version_file"
            printf '%s\n' "$file_version"
            return
        fi
    done
    printf '%s\n' "0.0-dev"
}

SCRIPT_VERSION="$(get_script_version)"

###############################################################################
# Dependency checks
###############################################################################

check_dependencies () {
    local req
    local -a requirements=(
        gum tr cut awk grep
        dbus-monitor dbus-send
        pactl parec
        mktemp mkfifo
    )
    for req in "${requirements[@]}"; do
        command -v "$req" >/dev/null 2>&1 && continue
        printf 'FATAL: %s\n' "$(t dep.missing_command "$req")" >&2
        [[ "$req" == "gum" ]] && printf '%s\n' "$(t dep.gum_install_hint)" >&2
        exit 1
    done
}

check_encoder_dependency () {
    local tool
    case "$record_format" in
        aac) tool="fdkaac" ;;
        ogg) tool="oggenc" ;;
        *) return ;;
    esac
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'FATAL: %s\n' "$(t dep.missing_encoder "$tool" "$record_format")" >&2
        exit 1
    fi
}

###############################################################################
# ELEMENT TYPES
#
# Every visual element on screen is produced by exactly one of the functions
# below (or, for the Spinner, one of the "gum spin" calls noted below). To
# change how an element type LOOKS, edit only its gum flags here - every
# screen that uses it picks up the change automatically. Nothing else in the
# script should call "gum style"/"gum table"/"gum pager"/"gum filter" directly
# for a boxed/bordered/full-screen element.
#
#   Title Bar     -> ui_title ()        top banner, alone (Finish screen only)
#   Title row     -> ui_title_row ()    Title Bar + Cancel hint joined side by
#                                        side via "gum join" - every other
#                                        screen starts with this instead
#   Normal        -> ui_box ()          standard content panel
#   Notification  -> ui_notify ()       validation-error panel, Finish screen
#   Cancel hint   -> ui_cancel_hint ()  bold text, never inside a bordered box
#                                        (it sits beside the Title Bar, not in
#                                        it - see ui_title_row)
#   Spinner       -> real "gum spin" calls in wizard_step_screen() (Recording
#                    Wizard steps) and profiles/*/profile.sh's
#                    recording_screen_render() - the --spinner flag picks the
#                    animation there
#   Table         -> ui_kv_table ()     "Field / Value" rows, a real "gum
#                                        table" (rounded border) - the
#                                        standard way this app shows any list
#                                        of labelled values (info/metadata/
#                                        status, Welcome's config summary).
#                                        Always a standalone sibling element,
#                                        never nested inside a Normal box.
#   Pager         -> ui_pager ()        a real "gum pager" invocation - full-
#                                        screen scrollable text, used only for
#                                        About Profile's README content
#   Gap           -> ui_gap ()          one blank line, printed right before
#                                        every interactive widget ("gum
#                                        choose"/"gum input"/"gum filter"/
#                                        "gum spin") so it never sits flush
#                                        against the element above it
#
# ui_subtitle (bold, centred heading - nested inside a Normal element, e.g. a
# Wizard step, or standalone above a Table, e.g. Welcome) and the shared table
# column widths (UI_TABLE_LABEL_WIDTH / UI_TABLE_VALUE_WIDTH, above) live here
# too. "gum filter" (Change Profile, see the Welcome/Profile screens further
# down) is this app's only other interactive selection widget besides "gum
# choose" - used there, and only there, because the profile list is meant to
# be searched, not just picked from a short fixed menu.
###############################################################################

require_tty () {
    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'FATAL: %s\n' "$(t err.requires_tty "${1:-this step}")" >&2
        exit 4
    fi
}

ui_clear () {
    printf '\033[H\033[2J'
}

# Title Bar element: always "LoopCatcher v$SCRIPT_VERSION - <screen name>".
# $2 (optional) overrides the box's content width - ui_title_row narrows it to
# make room for the Cancel hint beside it; alone (Finish screen) it is full
# width.
ui_title () {
    local width="${2:-$UI_BOX_CONTENT_WIDTH}"
    gum style --width "$width" --margin "1 0" --padding "1 1" --border normal --align center --bold -- \
        "LoopCatcher v$SCRIPT_VERSION - $1"
}

# "Tipo normal" element.
ui_box () {
    gum style --width "$UI_BOX_CONTENT_WIDTH" --margin "0 0" --padding "1 5" --border rounded -- "$@"
}

# Bold, centred subtitle. $2 (optional) overrides its width - defaults to
# UI_INNER_WIDTH (nested inside a Normal element, e.g. a Wizard step heading);
# pass UI_WIDTH when it stands on its own above a sibling Table element.
ui_subtitle () {
    local width="${2:-$UI_INNER_WIDTH}"
    gum style --width "$width" --margin "0 0" --padding "0 0" --bold --align center -- "$1"
}

# Notification element.
ui_notify () {
    gum style --width "$UI_NOTIFY_WIDTH" --margin "1 0" --padding "1 5" --border double --align center --foreground="#D5A021" --border-foreground="#D5A021" -- "$@"
}

# Cancel pseudo-element: bold, right-aligned in its own column, never inside a
# bordered element. Only ever composed into ui_title_row.
ui_cancel_hint () {
    gum style --width "$UI_HINT_WIDTH" --margin "0 0" --padding "1 1" --border thick --bold --align center --foreground="#D5A021" --border-foreground="#D5A021" -- "$(t ui.cancel_hint)"
}

# Gap element: one blank line, printed right before every interactive widget
# ("gum choose"/"gum input"/"gum spin") so it never sits flush against
# whatever was printed above it. The blank line itself comes from the empty
# content, not the margin - margin is "0 0" for now, bump it here later for
# more space.
ui_gap () {
    gum style --margin="0 0" -- ""
}

# Title Bar + Cancel hint, joined into one row: Title Bar on the left, hint on
# the right, vertically centred. Used at the top of every screen that shows
# the Cancel hint (i.e. every screen except Finish, which has no hint and uses
# ui_title() alone via render_page_plain).
ui_title_row () {
    gum join --horizontal --align center -- \
        "$(ui_title "$1" "$UI_TITLE_ROW_WIDTH")" "$(ui_cancel_hint)"
}

# Table element: every "Field / Value" list in the app (info/metadata/status,
# Welcome's config summary) is a standalone, self-bordered "gum table" - a
# sibling of the other elements on the page, not nested inside a Normal box.
# gum table's own --widths is a no-op in --print mode, so each field is padded
# to a fixed width (UI_TABLE_LABEL_WIDTH / UI_TABLE_VALUE_WIDTH) before gum
# ever sees it - gum then just renders already-fixed-width cells. $1/$2 are
# the two column headers (the first column's header doubles as the table's
# title, e.g. "Info"/"Metadata"/"Status" - leave $2 empty for no header on the
# value column); the rest are label/value pairs:
# ui_kv_table "<col1>" "<col2>" "L1" "V1" "L2" "V2" ...
ui_kv_table () {
    # gum table rejects a --columns list with a genuinely empty trailing
    # entry ("invalid number of columns" - it drops the empty token instead
    # of keeping an empty column name), so an empty header is a single space.
    local col1="$1" col2="${2:- }"; shift 2
    local rows="" label value padded_label padded_value
    while [[ $# -ge 2 ]]; do
        label="$1"; value="${2:--}"
        printf -v padded_label '%-*s' "$UI_TABLE_LABEL_WIDTH" "$label"
        printf -v padded_value '%-*s' "$UI_TABLE_VALUE_WIDTH" "$value"
        rows+="$padded_label"$'\t'"$padded_value"$'\n'
        shift 2
    done
    printf '%s' "$rows" | gum table --print --border rounded \
        --separator "$(printf '\t')" --columns "$col1,$col2"
}

# Pager element: a real "gum pager" invocation - full-screen scrollable text
# viewer. $1 is a file path (its content is shown verbatim). Used only for
# About Profile's README content, which can be arbitrarily long.
ui_pager () {
    gum pager < "$1"
}

# Shorten a long value (paths) so a table row does not wrap.
clip_text () {
    local s="$1" max="${2:-65}"
    if (( ${#s} > max )); then
        s="…${s: -$((max - 1))}"
    fi
    printf '%s' "$s"
}

# Common tail shared by render_page / render_page_plain: each pre-rendered
# element, flush against the next one - any spacing between elements comes
# only from an element's own gum padding/margin, never from this glue.
_render_elements () {
    local el
    for el in "$@"; do
        [[ -n "$el" ]] && printf '%s\n' "$el"
    done
}

# Every "Tipo normal" screen that shows the Cancel hint: clear, Title Bar +
# Cancel hint row, then each pre-rendered element. This is the default - use
# it unless the screen has no Cancel hint to show (only the Finish screen).
render_page () {
    local name="$1"; shift
    ui_clear
    printf '%s\n' "$(ui_title_row "$name")"
    _render_elements "$@"
}

# Same, but with a plain full-width Title Bar and no Cancel hint. Only the
# Finish screen uses this - it has nothing left to cancel.
render_page_plain () {
    local name="$1"; shift
    ui_clear
    printf '%s\n' "$(ui_title "$name")"
    _render_elements "$@"
}

_cancel_and_exit () {
    printf '%s\n' "$(t ui.cancelled)" >&2
    exit 0
}

# Alternate screen, used only for the live Recording / Finish screens.
screen_enter () {
    [[ -t 1 ]] && printf '\033[?1049h\033[?25l\033[2J\033[H'
}

screen_leave () {
    [[ -t 1 ]] && printf '\033[?25h\033[?1049l'
}

# In-place repaint for the Recording screen: home, write the frame, erase
# whatever the previous frame left below - avoids a full-clear flash.
paint_frame () {
    printf '\033[H%s\033[J' "$1"
}

###############################################################################
# Session log / debugging
#
# One log per session, written to log_file_path (configurable; defaults to
# "${TMPDIR:-/tmp}/loopcatcher/<session-name>.log"), recording every captured
# item (the same metadata the Recording screen shows, plus how long the
# capture took). Governed entirely by log_level: 0 no log is written (not even
# the file), 1 the log above, 2 also adds encoder (fdkaac / oggenc)
# diagnostics - debugging is intentionally limited to those two tools.
#
# Deliberately NOT translated: entries are structured/parseable (grep-able
# key="value" pairs) and meant to stay consistent across a language change,
# not prose read by a user - unlike everything else in this file.
###############################################################################

# The absolute path session logs are written to: log_file_path if the user
# set one, else the default. Shared by init_session_log and the Configuration
# screen (so the Paths group can show the effective value even before a
# session name is known, using a "<session>" placeholder).
effective_log_file_path () {
    if [[ -n "$log_file_path" ]]; then
        printf '%s' "$log_file_path"
    else
        printf '%s/%s.log' "${TMPDIR:-/tmp}/loopcatcher" "${session_name:-<session>}"
    fi
}

init_session_log () {
    [[ "$log_level" -ge 1 ]] || return 0
    session_log_path="$(effective_log_file_path)"
    mkdir -p -- "$(dirname "$session_log_path")" 2>/dev/null
}

log_line () {
    [[ "$log_level" -ge 1 && -n "$session_log_path" ]] || return 0
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$session_log_path" 2>/dev/null
}

# $1 artist $2 album $3 title $4 track number $5 disc number $6 output file
# $7 capture duration in seconds - the fields the Recording screen's
# Metadata table shows, plus duration.
log_recording () {
    log_line "captured artist=\"$1\" album=\"$2\" title=\"$3\" track=\"$4\" disc=\"$5\" file=\"$6\" duration_seconds=\"$7\""
}

log_debug () {
    [[ "$log_level" -ge 2 ]] || return 0
    log_line "DEBUG: $1"
}

###############################################################################
# Config file
###############################################################################

ensure_config_dir () {
    if ! mkdir -p -- "$config_dir"; then
        printf 'FATAL: %s\n' "$(t err.cannot_create_config_dir "$config_dir")" >&2
        exit 1
    fi
}

# Fixed, generic keys every config file has, independent of which profile
# module is active. Shared by save_config (what it always writes) and
# load_config (nothing special needed there - a bare "source" picks them up).
_fixed_config_keys () {
    printf '%s\n' log_level default_profile enabled_profiles nulloutput_name \
        aac_profile bitrate record_format filename_scheme output_directory \
        tail_drain_seconds log_file_path language
}

# The active profile module's own persisted config keys (see
# profile_config_schema() in the "Profile modules" section below).
_profile_schema_keys () {
    declare -F profile_config_schema >/dev/null 2>&1 || return 0
    profile_config_schema | cut -f1
}

# Reads the whole config file once, at process startup (see main()/
# _internal_wait, the only two callers, each running it exactly once). Every
# Settings/Profile Settings edit after that still validates and saves to disk
# immediately, but never calls this again - see "Settings edits" below and
# apply_config_changes().
load_config () {
    if [[ -r "$config_path" ]]; then
        # shellcheck disable=SC1090
        source "$config_path"
    fi

    # $language may have just changed from the top-of-file "auto" default to
    # whatever the config file persisted - re-resolve it (still "auto" re-
    # detects live, an explicit "en"/"es" is used as-is) and (re)load its
    # catalog file on top of the English baseline now that the real value is
    # known.
    effective_language="$(resolve_language)"
    load_lang_dir "$(lang_root)"

    if [[ -z "${default_profile:-}" ]] || ! _profile_available "$default_profile"; then
        default_profile="spotify_native"
    fi
    if [[ -z "${enabled_profiles:-}" ]]; then
        enabled_profiles="$default_profile"
    fi
    # default_profile's own module is always implicitly enabled, even if it
    # was left out of - or removed from - the persisted list.
    case " $enabled_profiles " in
        *" $default_profile "*) ;;
        *) enabled_profiles="$enabled_profiles $default_profile" ;;
    esac

    load_profile_module "$default_profile" || return 1

    # If none of the active module's schema-declared keys were already set by
    # the sourced file, this is its first use - seed it from the module's
    # own defaults and persist immediately, so the file gains that module's
    # full prefixed section (see profile_config_schema/profile_apply_defaults).
    local needs_seed=0 key
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        [[ -v "$key" ]] || { needs_seed=1; break; }
    done < <(_profile_schema_keys)

    if [[ $needs_seed -eq 1 ]]; then
        profile_apply_defaults
        save_config
    else
        profile_activate
    fi
}

save_config () {
    local tmp known_keys foreign_lines="" k
    local -a fixed_keys=()
    while IFS= read -r k; do fixed_keys+=("$k"); done < <(_fixed_config_keys)

    # Foreign lines: keys from the OLD file that belong to neither the fixed
    # generic set nor the currently active module - i.e. another module's
    # previously-persisted settings. Preserved verbatim so switching
    # default_profile away and back never silently drops them (we never
    # source an inactive module just to learn its own key list).
    if [[ -r "$config_path" ]]; then
        known_keys="$(IFS='|'; printf '%s' "${fixed_keys[*]}")"
        while IFS= read -r k; do
            [[ -n "$k" ]] && known_keys="$known_keys|$k"
        done < <(_profile_schema_keys)
        foreign_lines="$(grep -E '^[A-Za-z_][A-Za-z0-9_]*="' "$config_path" | grep -Ev "^($known_keys)=")"
    fi

    tmp="$(mktemp -- "$config_path.XXXXXX")" || {
        printf 'WARN: %s\n' "$(t warn.config_mktemp_failed "$config_dir")" >&2
        return 1
    }

    {
        printf '# loopcatcher config - edited at runtime via the Configuration screen.\n'
        for k in "${fixed_keys[@]}"; do
            printf '%s="%s"\n' "$k" "${!k}"
        done
        while IFS= read -r k; do
            [[ -n "$k" ]] || continue
            printf '%s="%s"\n' "$k" "${!k}"
        done < <(_profile_schema_keys)
        [[ -n "$foreign_lines" ]] && printf '%s\n' "$foreign_lines"
    } > "$tmp"

    # Atomic replace: a crash mid-write never leaves a truncated config.
    mv -f -- "$tmp" "$config_path" || { rm -f -- "$tmp"; return 1; }
}

# Prints the first problem it finds and returns 1; returns 0 when all valid.
# validate_settings is the hard (exit 1) startup wrapper; validate_settings_soft
# is used from the Configuration screen so a bad value cannot kill a run. Each
# t() call here is deliberately NOT wrapped in "$(...)" - both callers either
# capture the whole function's stdout themselves (command substitution there
# strips the trailing newline t() adds either way) or, for the hard-exit path,
# print directly to the terminal, where that trailing newline is wanted.
_validate_settings () {
    case "$record_format" in
        aac|ogg) ;;
        *) t err.invalid_record_format "$record_format"; return 1 ;;
    esac
    case "$filename_scheme" in
        normal|strict|strict-lc-nodir) ;;
        *) t err.invalid_filename_scheme "$filename_scheme"; return 1 ;;
    esac
    if ! _profile_available "$default_profile"; then
        t err.invalid_default_profile "$default_profile"; return 1
    fi
    if [[ ! "$bitrate" =~ ^[0-9]+$ ]] || [[ "$bitrate" -le 0 ]]; then
        t err.invalid_bitrate "$bitrate"; return 1
    fi
    if [[ ! "$aac_profile" =~ ^[0-9]+$ ]] || [[ "$aac_profile" -le 0 ]]; then
        t err.invalid_aac_profile "$aac_profile"; return 1
    fi
    if [[ ! "$tail_drain_seconds" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        t err.invalid_tail_drain_seconds "$tail_drain_seconds"; return 1
    fi
    case "$log_level" in
        0|1|2) ;;
        *) t err.invalid_log_level "$log_level"; return 1 ;;
    esac
    case "$language" in
        auto|en|es) ;;
        *) t err.invalid_language "$language"; return 1 ;;
    esac
    return 0
}

validate_settings () {
    _validate_settings || exit 1
}

validate_settings_soft () {
    _validate_settings
}

###############################################################################
# Profile modules
#
# A profile module is a directory under profiles/ (dev checkout) or
# /usr/share/loopcatcher/profiles/ (installed package - mirrors the same
# dual-path lookup get_script_version() already uses for VERSION) containing
# a profile.sh that gets `source`d directly into this process. Only one
# module is ever active at a time, so its functions/state share this script's
# global namespace - no per-module prefixing needed for functions, only for
# persisted config keys (see profile_config_schema in each module).
#
# Every profile.sh must define: profile_label, profile_config_schema,
# profile_apply_defaults, profile_activate, profile_wait_condition,
# profile_run, profile_cleanup. See profiles/spotify_native/profile.sh for a
# fully worked example and AGENTS.md for the full contract. A module may also
# ship its own lang/ directory (one file per language, pure MSG_en/MSG_es
# data - its friendly label and its Profile Settings field labels), sourced
# alongside profile.sh below.
###############################################################################

profiles_root () {
    local script_dir
    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    if [[ -d "$script_dir/profiles" ]]; then
        printf '%s\n' "$script_dir/profiles"
    else
        printf '%s\n' "/usr/share/loopcatcher/profiles"
    fi
}

# Every discovered module directory name (has a profiles/<name>/profile.sh),
# sorted. Used by Change Profile and the Enabled Profiles settings screen.
list_profile_modules () {
    local dir name root
    root="$(profiles_root)"
    [[ -d "$root" ]] || return 0
    for dir in "$root"/*/; do
        [[ -d "$dir" ]] || continue
        name="$(basename "$dir")"
        [[ -f "$dir/profile.sh" ]] && printf '%s\n' "$name"
    done | sort
}

# True when $1 names a module that both exists on disk and is listed in
# enabled_profiles.
_profile_available () {
    local name="$1" m
    [[ -n "$name" ]] || return 1
    [[ -f "$(profiles_root)/$name/profile.sh" ]] || return 1
    for m in ${enabled_profiles:-}; do
        [[ "$m" == "$name" ]] && return 0
    done
    return 1
}

# Sources profiles/<name>/lang/ (if present - one file per language, same
# convention as lang_root(), see load_lang_dir() above) and
# profiles/<name>/profile.sh into this process. load_config() is the only
# caller, and it only ever runs once per process (see main()/_internal_wait)
# - so this never needs to guard against loading a second, different module
# mid-session.
load_profile_module () {
    local name="$1" path lang_dir
    path="$(profiles_root)/$name/profile.sh"
    if [[ ! -r "$path" ]]; then
        printf 'FATAL: %s\n' "$(t err.profile_module_not_found "$name" "$path")" >&2
        return 1
    fi
    lang_dir="$(profiles_root)/$name/lang"
    [[ -d "$lang_dir" ]] && load_lang_dir "$lang_dir"
    # shellcheck disable=SC1090
    source "$path"
}

###############################################################################
# Output directory / session name
###############################################################################

pick_directory () {
    local start="${1:-$HOME}"
    [[ -d "$start" ]] || start="$HOME"
    gum file --directory --height=10 "$start"
}

# Best guess at the user's Music folder. Never prints just $HOME (xdg-user-dir
# returns that when MUSIC is unconfigured) - falls through to $HOME/Music.
default_music_dir () {
    local dir=""
    if command -v xdg-user-dir >/dev/null 2>&1; then
        dir="$(xdg-user-dir MUSIC 2>/dev/null || true)"
        [[ -n "$dir" && "$dir" != "$HOME" ]] && { printf '%s\n' "$dir"; return; }
    fi
    if [[ -f "$HOME/.config/user-dirs.dirs" ]]; then
        dir="$(grep '^XDG_MUSIC_DIR=' "$HOME/.config/user-dirs.dirs" | cut -d'=' -f2- | tr -d '"')"
        dir="${dir//\$HOME/$HOME}"
        [[ -n "$dir" && "$dir" != "$HOME" ]] && { printf '%s\n' "$dir"; return; }
    fi
    printf '%s\n' "$HOME/Music"
}

initialize_output_directory () {
    [[ -n "$output_directory" ]] || output_directory="$(default_music_dir)"
    if [[ -z "$output_directory" ]]; then
        printf 'FATAL: %s\n' "$(t err.no_output_directory)" >&2
        exit 1
    fi
    if ! mkdir -p -- "$output_directory"; then
        printf 'FATAL: %s\n' "$(t err.cannot_create_output_directory "$output_directory")" >&2
        exit 1
    fi
}

default_session_name () {
    printf '%s-loopcatcher\n' "$(date +%Y%m%d-%H%M%S)"
}

# Reject a name that cannot be one safe path component. Prints the reason.
validate_session_name () {
    case "${1:-}" in
        "")       t err.session_name_empty ;;
        . | ..)   t err.session_name_dots ;;
        */*)      t err.session_name_slash ;;
        *)        return 0 ;;
    esac
    return 1
}

# 0 when directory $1 exists and holds at least one entry (dotfiles included).
dir_not_empty () {
    local d="$1" e
    [[ -d "$d" ]] || return 1
    for e in "$d"/* "$d"/.[!.]* "$d"/..?*; do
        [[ -e "$e" || -L "$e" ]] && return 0
    done
    return 1
}

###############################################################################
# Welcome screen (main menu)
###############################################################################

welcome_screen () {
    local choice i

    while true; do
        local -a ids=(continue profile settings)
        local -a items=("$(t welcome.menu.continue)" "$(t welcome.menu.profile)" "$(t welcome.menu.settings)")
        # "Apply configuration change" only appears once there's actually a
        # saved-but-not-yet-applied change to apply (config_changed, set by
        # _cfg_edit_input/_cfg_edit_choice/change_profile_screen/the two
        # inline saves in config_group_paths and config_group_enabled_profiles
        # - every user-initiated save site, deliberately not save_config()
        # itself, since that would also fire on load_config()'s automatic
        # first-run module seeding).
        if [[ "$config_changed" == "true" ]]; then
            ids+=(apply)
            items+=("$(t welcome.menu.apply_changes)")
        fi
        ids+=(about exit)
        items+=("$(t welcome.menu.about)" "$(t welcome.menu.exit)")

        render_page "$(t welcome.title)" \
            "$(ui_box "$(t welcome.message)")" \
            "$(ui_subtitle "$(t welcome.config_heading)" "$UI_WIDTH")" \
            "$(ui_kv_table "$(t common.table.field)" "$(t common.table.value)" \
                "$(t welcome.field.codec)" "$record_format" \
                "$(t welcome.field.aac_profile)" "$aac_profile" \
                "$(t welcome.field.bitrate)" "${bitrate} kbps" \
                "$(t welcome.field.player_profile)" "$default_profile" \
                "$(t welcome.field.output_directory)" "$(clip_text "$output_directory")")"
        ui_gap
        choice="$(gum choose --header "$(t welcome.menu.header)" --cursor="$UI_CURSOR" --selected "${items[0]}" -- "${items[@]}")" || _cancel_and_exit
        for i in "${!items[@]}"; do
            [[ "$choice" == "${items[$i]}" ]] || continue
            case "${ids[$i]}" in
                continue) return ;;
                profile)  profile_menu ;;
                settings) config_screen ;;
                apply)    apply_config_changes ;;
                about)    about_screen ;;
                exit)     _cancel_and_exit ;;
            esac
            break
        done
    done
}

# "exec" replaces this process outright (same technique the Recording
# Wizard's own "$0 --internal-wait ..." re-exec already relies on) - a true,
# immediate restart straight back into a freshly-sourced script and a fresh
# load_config(), picking up whatever Settings/Profile Settings edits were
# saved to disk during this run (see "Settings edits" - nothing reloads
# mid-session, this is the only way to apply them without relaunching by hand).
apply_config_changes () {
    exec "$0"
}

profile_menu () {
    local choice i
    local -a ids=(change settings about back)
    while true; do
        local -a items=(
            "$(t profile.menu.change)"
            "$(t profile.menu.settings)"
            "$(t profile.menu.about)"
            "$(t common.back)"
        )
        render_page "$(t profile.title)"
        ui_gap
        choice="$(gum choose --header "$(t profile.menu.header "$default_profile")" --cursor="$UI_CURSOR" -- "${items[@]}")" || return
        for i in "${!items[@]}"; do
            [[ "$choice" == "${items[$i]}" ]] || continue
            case "${ids[$i]}" in
                change)   change_profile_screen ;;
                settings) profile_settings_screen ;;
                about)    about_profile_screen ;;
                back)     return ;;
            esac
            break
        done
    done
}

# Just another field edit now (see "Settings edits"): saves default_profile
# and returns to profile_menu - it takes "Apply configuration change" from
# the Welcome menu to actually load the newly-chosen module.
change_profile_screen () {
    local -a available=()
    local m choice
    for m in $(list_profile_modules); do
        case " $enabled_profiles " in
            *" $m "*) available+=("$m") ;;
        esac
    done
    [[ ${#available[@]} -eq 0 ]] && available=("$default_profile")

    render_page "$(t profile.title)"
    ui_gap
    choice="$(gum filter --header "$(t profile.change.header)" --prompt="$UI_CURSOR" -- "${available[@]}")" || return
    [[ -n "$choice" && "$choice" != "$default_profile" ]] || return

    default_profile="$choice"
    save_config
    config_changed=true
}

# Reads the active module's profile_config_schema() into parallel arrays so
# the caller can build a menu and dispatch input/choice editors generically -
# the same way the Configuration screen's own groups do below.
_profile_schema_rows () {
    schema_keys=(); schema_labels=(); schema_kinds=(); schema_choices=()
    local key label default kind choices
    # shellcheck disable=SC2034  # "default" is positional-only here - profile_apply_defaults() is what actually applies it
    while IFS=$'\t' read -r key label default kind choices; do
        [[ -n "$key" ]] || continue
        schema_keys+=("$key")
        schema_labels+=("$label")
        schema_kinds+=("$kind")
        schema_choices+=("$choices")
    done < <(profile_config_schema)
}

profile_settings_screen () {
    local choice i key back_label
    while true; do
        _profile_schema_rows
        back_label="$(t common.back)"
        local -a menu_items=()
        for i in "${!schema_keys[@]}"; do
            key="${schema_keys[$i]}"
            menu_items+=("${schema_labels[$i]}:  ${!key}")
        done
        menu_items+=("$back_label")

        render_page "$(t config.title)"
        ui_gap
        choice="$(gum choose --header "$(t profile.settings.header "$(profile_label)")" --cursor="$UI_CURSOR" -- "${menu_items[@]}")" || return
        [[ "$choice" != "$back_label" ]] || return

        for i in "${!schema_keys[@]}"; do
            [[ "$choice" == "${menu_items[$i]}" ]] || continue
            if [[ "${schema_kinds[$i]}" == "choice" ]]; then
                # shellcheck disable=SC2086
                _cfg_edit_choice "${schema_keys[$i]}" "${schema_labels[$i]}" ${schema_choices[$i]}
            else
                _cfg_edit_input "${schema_keys[$i]}" "${schema_labels[$i]}"
            fi
            break
        done
    done
}

about_profile_screen () {
    local readme
    readme="$(profiles_root)/$default_profile/README.md"
    render_page "$(t profile.title)"
    if [[ -r "$readme" ]]; then
        ui_pager "$readme"
    else
        printf '%s\n' "$(ui_notify "$(t profile.about.no_readme)")"
        ui_gap
        printf '%s\n' "$(gum style --bold -- "$(t common.press_any_key_continue)")"
        read -rsn1 || true
    fi
}

about_screen () {
    render_page "$(t about.title)" \
        "$(ui_box \
            "$(t about.app_line "$SCRIPT_VERSION")" \
            "" \
            "$(t about.description)" \
            "" \
            "$(t about.license)" \
            "$(t about.homepage)")"
    ui_gap
    printf '%s\n' "$(gum style --bold -- "$(t common.press_any_key_continue)")"
    read -rsn1 || true
}

###############################################################################
# Session Name screen
###############################################################################

session_name_screen () {
    local suggested prefill="" err="" value candidate

    suggested="$(default_session_name)"

    while true; do
        render_page "$(t session.title)" \
            "$(ui_box \
                "$(t session.intro)" \
                "" \
                "$(gum style --bold -- "$(t session.instruction)")")"
        [[ -n "$err" ]] && printf '%s\n' "$(ui_notify "$err")"
        ui_gap

        if ! value="$(gum input --header "$(t session.input_header)" \
                --prompt="$UI_CURSOR" --placeholder "$suggested" --value "$prefill")"; then
            _cancel_and_exit
        fi
        [[ -z "$value" ]] && value="$suggested"

        if ! err="$(validate_session_name "$value")"; then
            prefill="$value"; continue
        fi
        candidate="$output_directory/$value"
        if dir_not_empty "$candidate"; then
            err="$(t session.error.folder_not_empty "$candidate")"
            prefill="$value"; continue
        fi
        break
    done

    session_name="$value"
    session_output_directory="$candidate"
    mkdir -p -- "$session_output_directory" \
        || { printf 'FATAL: %s\n' "$(t err.cannot_create_session_folder "$candidate")" >&2; exit 1; }
}

###############################################################################
# Configuration screen (Tipo Configuracion)
###############################################################################

# Edit one variable with gum input, validating and auto-saving on success.
# Never reloads (see "Settings edits" at the top of this file) - the edited
# global was already mutated directly below, so the current screen's own next
# redraw already reflects it.
_cfg_edit_input () {
    local var="$1" header="$2" new err=""
    while true; do
        render_page "$(t config.title)"
        [[ -n "$err" ]] && printf '%s\n' "$(ui_notify "$err")"
        ui_gap
        new="$(gum input --header "$header" --prompt="$UI_CURSOR" --value "${!var}")" || return 0
        printf -v "$var" '%s' "$new"
        if err="$(validate_settings_soft 2>&1)"; then
            save_config
            config_changed=true
            return 0
        fi
    done
}

_cfg_edit_choice () {
    local var="$1" header="$2"; shift 2
    local new err=""
    while true; do
        render_page "$(t config.title)"
        [[ -n "$err" ]] && printf '%s\n' "$(ui_notify "$err")"
        ui_gap
        new="$(gum choose --header "$header" --cursor="$UI_CURSOR" --selected "${!var}" -- "$@")" || return 0
        printf -v "$var" '%s' "$new"
        if err="$(validate_settings_soft 2>&1)"; then
            save_config
            config_changed=true
            return 0
        fi
    done
}

config_group_codecs () {
    local choice i
    local -a ids=(record_format aac_profile bitrate back)
    while true; do
        local -a items=(
            "$(t config.codecs.record_format "$record_format")"
            "$(t config.codecs.aac_profile "$aac_profile")"
            "$(t config.codecs.bitrate "$bitrate")"
            "$(t common.back)"
        )
        render_page "$(t config.title)"
        ui_gap
        choice="$(gum choose --header "$(t config.group.codecs)" --cursor="$UI_CURSOR" -- "${items[@]}")" || return
        for i in "${!items[@]}"; do
            [[ "$choice" == "${items[$i]}" ]] || continue
            case "${ids[$i]}" in
                record_format) _cfg_edit_choice record_format "$(t config.codecs.record_format_prompt)" aac ogg ;;
                aac_profile)   _cfg_edit_input  aac_profile "$(t config.codecs.aac_profile_prompt)" ;;
                bitrate)       _cfg_edit_input  bitrate "$(t config.codecs.bitrate_prompt)" ;;
                back)          return ;;
            esac
            break
        done
    done
}

config_group_paths () {
    local choice d i
    local -a ids=(output_folder filename_scheme log_file back)
    while true; do
        local -a items=(
            "$(t config.paths.output_folder "$output_directory")"
            "$(t config.paths.filename_scheme "$filename_scheme")"
            "$(t config.paths.log_file "$(effective_log_file_path)")"
            "$(t common.back)"
        )
        render_page "$(t config.title)"
        ui_gap
        choice="$(gum choose --header "$(t config.group.paths)" --cursor="$UI_CURSOR" -- "${items[@]}")" || return
        for i in "${!items[@]}"; do
            [[ "$choice" == "${items[$i]}" ]] || continue
            case "${ids[$i]}" in
                output_folder)
                    d="$(pick_directory "${output_directory:-$HOME}")" \
                        && [[ -n "$d" ]] && { output_directory="$d"; mkdir -p -- "$output_directory"; save_config; config_changed=true; }
                    ;;
                filename_scheme)
                    _cfg_edit_choice filename_scheme "$(t config.paths.filename_scheme_prompt)" normal strict strict-lc-nodir
                    ;;
                log_file)
                    _cfg_edit_input log_file_path "$(t config.paths.log_file_prompt "${TMPDIR:-/tmp}/loopcatcher/<session>.log")"
                    ;;
                back) return ;;
            esac
            break
        done
    done
}

config_group_enabled_profiles () {
    local -a all=() selected=() chosen=()
    local m chosen_raw selected_csv

    while IFS= read -r m; do
        [[ -n "$m" ]] && all+=("$m")
    done < <(list_profile_modules)
    [[ ${#all[@]} -eq 0 ]] && all=("$default_profile")

    for m in $enabled_profiles; do
        selected+=("$m")
    done
    selected_csv="$(IFS=,; printf '%s' "${selected[*]}")"

    render_page "$(t config.title)"
    ui_gap
    if ! chosen_raw="$(gum choose --header "$(t config.enabled_profiles.header)" \
            --cursor="$UI_CURSOR" --no-limit --selected "$selected_csv" -- "${all[@]}")"; then
        return
    fi

    chosen=()
    if [[ -n "$chosen_raw" ]]; then
        while IFS= read -r m; do
            [[ -n "$m" ]] && chosen+=("$m")
        done <<< "$chosen_raw"
    fi
    case " ${chosen[*]:-} " in
        *" $default_profile "*) ;;
        *) chosen+=("$default_profile") ;;
    esac

    enabled_profiles="${chosen[*]}"
    save_config
    config_changed=true
}

config_group_advanced () {
    local choice i
    local -a ids=(tail_drain_seconds log_level nulloutput_name back)
    while true; do
        local -a items=(
            "$(t config.advanced.tail_drain_seconds "$tail_drain_seconds")"
            "$(t config.advanced.log_level "$log_level")"
            "$(t config.advanced.nulloutput_name "$nulloutput_name")"
            "$(t common.back)"
        )
        render_page "$(t config.title)"
        ui_gap
        choice="$(gum choose --header "$(t config.group.advanced)" --cursor="$UI_CURSOR" -- "${items[@]}")" || return
        for i in "${!items[@]}"; do
            [[ "$choice" == "${items[$i]}" ]] || continue
            case "${ids[$i]}" in
                tail_drain_seconds) _cfg_edit_input tail_drain_seconds "$(t config.advanced.tail_drain_seconds_prompt)" ;;
                log_level)          _cfg_edit_choice log_level "$(t config.advanced.log_level_prompt)" 0 1 2 ;;
                nulloutput_name)    _cfg_edit_input nulloutput_name "$(t config.advanced.nulloutput_name_prompt)" ;;
                back)                return ;;
            esac
            break
        done
    done
}

# Reachable only from the Welcome screen; returning here always goes back to it.
# Language lives directly here, not nested inside a group - it's the one
# Settings field important/global enough to be one level up, alongside the
# group picker itself, rather than buried inside Advanced.
config_screen () {
    local choice i
    local -a ids=(codecs paths enabled_profiles advanced language back)
    while true; do
        local -a items=(
            "$(t config.group.codecs)"
            "$(t config.group.paths)"
            "$(t config.group.enabled_profiles)"
            "$(t config.group.advanced)"
            "$(t config.top.language "$language")"
            "$(t common.back)"
        )
        render_page "$(t config.title)" \
            "$(ui_notify \
                "$(t config.notify.autosave)" \
                "$(t config.notify.requires_apply)" \
                "$(t config.notify.edit_directly)" \
                "" \
                "$config_path")"
        ui_gap
        choice="$(gum choose --header "$(t config.header)" --cursor="$UI_CURSOR" -- "${items[@]}")" || return
        for i in "${!items[@]}"; do
            [[ "$choice" == "${items[$i]}" ]] || continue
            case "${ids[$i]}" in
                codecs)            config_group_codecs ;;
                paths)             config_group_paths ;;
                enabled_profiles)  config_group_enabled_profiles ;;
                advanced)          config_group_advanced ;;
                language)          _cfg_edit_choice language "$(t config.top.language_prompt)" auto en es ;;
                back)              return ;;
            esac
            break
        done
    done
}

###############################################################################
# Recording Wizard
#
# wizard_step_screen() is the generic, reusable step-screen renderer: any
# profile module's profile_run() can call it. $4 (heading) and the remaining
# instruction-line args are expected to already be translated by the caller -
# this function itself only knows the generic "kind" vocabulary (sink/
# stopped/playing) for the spinner title. The actual step sequence (which
# steps, in what order, and what conditions gate them) is owned entirely by
# the active module - see profiles/spotify_native/profile.sh's profile_run().
###############################################################################

wizard_step_screen () {
    local n="$1" spinner="$2" kind="$3" heading="$4"; shift 4
    local spin_title
    case "$kind" in
        sink)    spin_title="$(t wizard.spin.sink)" ;;
        stopped) spin_title="$(t wizard.spin.stopped)" ;;
        playing) spin_title="$(t wizard.spin.playing)" ;;
        *)       spin_title="$(t wizard.spin.default)" ;;
    esac

    render_page "$(t wizard.title)" \
        "$(ui_box "$(ui_subtitle "$(t wizard.step_label "$n" "$heading")")" "" "$@")"
    ui_gap

    gum spin --spinner "$spinner" --title "$spin_title" -- \
        "$0" --internal-wait "$kind" --config "$config_path" \
        || _cancel_and_exit
}

###############################################################################
# Audio server / sink detection / routing
###############################################################################

check_audio_server () {
    if ! pactl info >/dev/null 2>&1; then
        printf 'FATAL: %s\n' "$(t err.audio_server_unreachable)" >&2
        printf '%s\n' "$(t err.audio_server_kde_hint)" >&2
        printf '%s\n' "$(t err.audio_server_try_hint)" >&2
        exit 1
    fi
}

is_target_sink_app () {
    local configured_name="$1" app_name="$2" pat
    local -a pats

    [[ -n "$configured_name" && "$app_name" == "$configured_name" ]] && return 0

    read -r -a pats <<< "$player_sink_match"
    for pat in "${pats[@]}"; do
        # Unquoted RHS on purpose: pat is a glob from the player profile.
        # shellcheck disable=SC2053
        [[ "${app_name,,}" == ${pat,,} ]] && return 0
    done
    return 1
}

# Sets source_sink_index. Returns: 0 matched, 2 no sink-inputs, 3 none matched.
get_target_sink_index () {
    local sink_list sink_index="" sink_app="" line

    sink_list="$(pactl list sink-inputs 2>/dev/null)"
    [[ -z "$sink_list" ]] && return 2

    while IFS= read -r line; do
        if [[ $line == "Sink Input #"* ]]; then
            sink_index="${line#Sink Input #}"
        elif [[ $line == *"application.name = "* ]]; then
            sink_app="$(cut -d '"' -f2 <<< "$line")"
            if is_target_sink_app "$sink_app_name" "$sink_app"; then
                source_sink_index="$sink_index"
                log_debug "matched target sink: $sink_app"
                return 0
            fi
        fi
    done <<< "$sink_list"

    return 3
}

ensure_target_routed () {
    # Fast path: reuse the cached sink-input id (move-sink-input is idempotent).
    if [[ -n "$source_sink_index" ]] \
        && pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        return 0
    fi

    # Slow path: the player likely replaced its sink-input (e.g. track change).
    # Non-fatal so a transient failure does not kill the run.
    get_target_sink_index || return 1
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        log_line "could not move sink-input $source_sink_index to '$nulloutput_name'"
        return 1
    fi
    return 0
}

# Module ids of every loaded module-null-sink whose sink_name is exactly
# $nulloutput_name (an exact token match, so "loopcatcher" != "loopcatcher2").
_null_sink_module_ids () {
    pactl list short modules 2>/dev/null | awk -v want="sink_name=$nulloutput_name" '
        $2 == "module-null-sink" {
            n = split($0, tok, /[ \t]+/)
            for (i = 1; i <= n; i++) if (tok[i] == want) { print $1; break }
        }'
}

create_null_audio_output () {
    # Reuse an existing sink of our name (e.g. leftover from a crashed run);
    # otherwise load a fresh one. cleanup() unloads it either way.
    [[ -n "$(_null_sink_module_ids)" ]] && return 0
    if ! pactl load-module module-null-sink sink_name="$nulloutput_name" >/dev/null; then
        printf 'FATAL: %s\n' "$(t err.cannot_create_null_sink "$nulloutput_name")" >&2
        exit 1
    fi
}

move_target_output () {
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        printf 'FATAL: %s\n' "$(t err.cannot_move_sink_input "$source_sink_index" "$nulloutput_name")" >&2
        exit 1
    fi
}

###############################################################################
# Filename building
###############################################################################

sanitize_str () {
    if [[ "$1" == "strict" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2"
    elif [[ "$1" == "strict-lc" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2" | tr '[:upper:]' '[:lower:]'
    fi
}

# "normal" scheme component: keep Unicode letters/marks, strip only path-unsafe
# / FAT/NTFS-reserved chars so recordings to removable drives still work.
sanitize_component () {
    local s="$1"
    s="${s//\//_}"
    s="${s//\\/_}"
    s="${s//:/_}"
    s="${s//\*/_}"
    s="${s//\?/_}"
    s="${s//\"/_}"
    s="${s//</_}"
    s="${s//>/_}"
    s="${s//|/_}"
    # Fold whitespace to single spaces, then drop remaining ASCII control chars.
    # Byte-based, so UTF-8 multibyte sequences pass through untouched.
    s="$(printf '%s' "$s" | tr -s '[:space:]' ' ')"
    s="$(printf '%s' "$s" | tr -d '\000-\037\177')"
    s="${s#"${s%%[![:space:].]*}"}"
    s="${s%"${s##*[![:space:].]}"}"
    [[ -n "$s" ]] || s="$(t filename.unknown_component)"
    printf '%s' "$s"
}

unique_output_path () {
    local base="$1"
    [[ ! -e "$base" ]] && { printf '%s\n' "$base"; return; }

    local dir file ext stem n=2
    dir="$(dirname "$base")"
    file="$(basename "$base")"
    ext="${file##*.}"
    stem="${file%.*}"
    while [[ -e "$dir/${stem}_$n.$ext" ]]; do
        n=$((n + 1))
    done
    printf '%s\n' "$dir/${stem}_$n.$ext"
}

file_path_structure () {
    local i_artist="$1" i_album="$2" i_title="$3" extension="$4"
    local outdir outfile base

    case "$filename_scheme" in
        normal)
            outdir="$session_output_directory/$(sanitize_component "$i_artist")/$(sanitize_component "$i_album")"
            outfile="$(sanitize_component "$i_title").$extension"
            ;;
        strict)
            outdir="$session_output_directory/$(sanitize_str "strict" "$i_artist")/$(sanitize_str "strict" "$i_album")"
            outfile="$(sanitize_str "strict" "$i_title").$extension"
            ;;
        strict-lc-nodir)
            outdir="$session_output_directory"
            outfile="$(sanitize_str "strict-lc" "$i_artist")_$(sanitize_str "strict-lc" "$i_album")_$(sanitize_str "strict-lc" "$i_title").$extension"
            ;;
        *)
            # Unreachable: filename_scheme is validated at startup.
            printf 'FATAL: %s\n' "$(t err.invalid_filename_scheme_runtime "$filename_scheme")" >&2
            exit 1
            ;;
    esac

    mkdir -p -- "$outdir"
    base="$outdir/$outfile"
    unique_output_path "$base"
}

###############################################################################
# Recording engine
###############################################################################

# stop_current_recording [quick|drain]
#   quick (default) - track change: stop capture and return immediately; the
#     encoder keeps running, sees EOF, finalizes its file and exits on its own.
#   drain           - session end: keep capturing for tail_drain_seconds, stop
#     capture, then wait for the encoder to finish writing the file.
stop_current_recording () {
    local mode="${1:-quick}"
    local fifo_dir="$record_fifo_dir"
    local old_encoder="$encoder_pid"
    local old_parec="$parec_pid"
    local waited=0 duration=""

    [[ "$stopping_recording" == "true" ]] && return
    stopping_recording=true

    if [[ "$mode" == "drain" && -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        sleep "$tail_drain_seconds"
    fi

    # Stop capture first so the encoder gets EOF and can flush a clean trailer.
    if [[ -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        kill "$old_parec" 2>/dev/null || true
    fi

    # Capture duration is measured here, right as capture actually stops - not
    # after the encoder-finalize wait below, which is not part of the audio.
    [[ -n "$record_log_file" ]] && duration=$((SECONDS - record_start_seconds))

    parec_pid=""
    encoder_pid=""
    record_fifo_dir=""

    if [[ "$mode" == "drain" && -n "$old_encoder" ]]; then
        while kill -0 "$old_encoder" 2>/dev/null && [[ $waited -lt 60 ]]; do
            sleep 0.05
            waited=$((waited + 1))
        done
        if kill -0 "$old_encoder" 2>/dev/null; then
            kill "$old_encoder" 2>/dev/null || true
        fi
    fi

    if [[ -n "$record_log_file" ]]; then
        log_recording "$record_log_artist" "$record_log_album" "$record_log_title" \
            "$record_log_tracknumber" "$record_log_discnumber" "$record_log_file" "$duration"
        record_log_file=""
    fi

    # Safe to remove now: an unlinked FIFO / log stays valid for a background
    # encoder still finalizing (its output file lives elsewhere).
    [[ -n "$fifo_dir" && -d "$fifo_dir" ]] && rm -rf "$fifo_dir"
    [[ -n "$record_error_log" && -f "$record_error_log" ]] && rm -f "$record_error_log"
    record_error_log=""

    stopping_recording=false
}

start_recording () {
    local i_artist="$1" i_album="$2" i_title="$3" i_albumartist="$4" i_tracknumber="$5" i_discnumber="$6"
    local outputfile="" record_fifo="" ext

    [[ -z "$i_title" || -z "$i_artist" ]] && return 1

    ext="m4a"
    [[ "$record_format" == "ogg" ]] && ext="oga"
    outputfile="$(file_path_structure "$i_artist" "$i_album" "$i_title" "$ext")"
    stop_current_recording

    if ! ensure_target_routed; then
        recording_failed=true; status_dirty=1
        log_line "could not route target sink to monitor output"
        return 1
    fi

    record_error_log="$(mktemp)"
    record_fifo_dir="$(mktemp -d)"
    record_fifo="$record_fifo_dir/pcm"
    if ! mkfifo "$record_fifo" 2>/dev/null; then
        log_line "could not create capture pipe under $record_fifo_dir"
        stop_current_recording
        return 1
    fi

    log_debug "encoder command: format=$record_format aac_profile=$aac_profile bitrate=${bitrate}k output=$outputfile"

    # OGG (unlike MP4/AAC) genuinely supports multiple ARTIST= comment
    # fields on one file. "oggenc --artist" doesn't add one, though - it
    # associates one artist per input FILE when repeated across a batch, not
    # multiple values on a single file - so every captured xesam:artist goes
    # through "-c ARTIST=..." instead, once per value. Falls back to
    # "--artist $i_artist" only if artist_all is empty (e.g. start_recording
    # invoked directly, bypassing the MPRIS parser, as tests do).
    local -a ogg_artist_args=()
    local _a
    for _a in "${artist_all[@]}"; do
        [[ -n "$_a" ]] && ogg_artist_args+=(-c "ARTIST=$_a")
    done
    [[ ${#ogg_artist_args[@]} -eq 0 ]] && ogg_artist_args=(--artist "$i_artist")

    # Encoder first (blocks on the pipe until parec writes), then capture.
    # Separately tracked processes let us stop capture first on shutdown so the
    # encoder can flush and finalize instead of being killed mid-stream.
    case "$record_format" in
        aac)
            # MP4's ©ART atom holds one string, not a repeatable list, so AAC
            # is tagged with only the first artist - same simplification as
            # the session log and file/folder naming.
            fdkaac -R -S -p "$aac_profile" --bitrate "${bitrate}k" --moov-before-mdat --afterburner 1 \
                --title "$i_title" --artist "$i_artist" --album "$i_album" --album-artist "$i_albumartist" \
                --track "$i_tracknumber" --disk "$i_discnumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        ogg)
            oggenc -b "$bitrate" --raw \
                --title "$i_title" "${ogg_artist_args[@]}" --album "$i_album" --tracknum "$i_tracknumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        *)
            recording_failed=true; status_dirty=1
            log_line "invalid record_format '$record_format'"
            stop_current_recording
            return 1
            ;;
    esac

    # Low capture latency keeps less audio stranded in the server buffer.
    parec -d "$nulloutput_name.monitor" --latency-msec=30 > "$record_fifo" 2>>"$record_error_log" &
    parec_pid=$!

    sleep 0.2
    if ! kill -0 "$parec_pid" 2>/dev/null || ! kill -0 "$encoder_pid" 2>/dev/null; then
        local err=""
        [[ -s "$record_error_log" ]] && err="$(tr '\n' ' ' < "$record_error_log")"
        kill "$parec_pid" "$encoder_pid" 2>/dev/null || true
        stop_current_recording
        [[ -n "$outputfile" ]] && rm -f "$outputfile"
        recording_failed=true; status_dirty=1
        log_line "recorder failed to start: ${err:-check codec dependencies and format settings}"
        return 1
    fi

    # shellcheck disable=SC2034  # recording_failed/status_dirty are read by the active profile module's recording_screen_render()
    recording_failed=false; status_dirty=1
    tui_set "output" "$outputfile"

    # Logged once this recording actually stops (see stop_current_recording),
    # so the log entry can include the real capture duration.
    record_start_seconds=$SECONDS
    record_log_artist="$i_artist"
    record_log_album="$i_album"
    record_log_title="$i_title"
    record_log_tracknumber="$i_tracknumber"
    record_log_discnumber="$i_discnumber"
    record_log_file="$outputfile"
    return 0
}

###############################################################################
# Recording screen support (generic helpers - the screen itself is rendered
# by the active profile module's recording_screen_render(), which calls these)
###############################################################################

# shellcheck disable=SC2034  # tui_*/status_dirty are read by the active profile module's recording_screen_render()
tui_set () {
    case "$1" in
        track)       tui_track="$2" ;;
        artist)      tui_artist="$2" ;;
        album)       tui_album="$2" ;;
        tracknumber) tui_tracknumber="$2" ;;
        discnumber)  tui_discnumber="$2" ;;
        output)      tui_output="$2" ;;
    esac
    status_dirty=1
    return 0
}

# tui_output made relative to the session folder (Artist/Album/File).
status_output_relpath () {
    local f="${tui_output:--}"
    if [[ "$f" == "-" || -z "$f" ]]; then
        printf -- '-'
    elif [[ -n "$session_output_directory" && "$f" == "$session_output_directory/"* ]]; then
        printf '%s' "${f#"$session_output_directory"/}"
    else
        printf '%s' "$f"
    fi
}

_kill_spinner () {
    if [[ -n "$_spinner_pid" ]]; then
        kill "$_spinner_pid" 2>/dev/null || true
        wait "$_spinner_pid" 2>/dev/null || true
    fi
    _spinner_pid=""
}

# shellcheck disable=SC2034  # should_exit is read by the active profile module's recording_main_loop()
end_session () {
    session_ended=true
    should_exit=1
}

###############################################################################
# Finish screen
###############################################################################

finish_screen () {
    render_page_plain "$(t finish.title)" \
        "$(ui_notify "$(t finish.notification)")" \
        "$(ui_box "$(t finish.saved_in)" "" "$session_output_directory")"
    ui_gap
    printf '%s\n' "$(gum style --bold -- "$(t finish.press_any_key_exit)")"
    read -rsn1 || true
}

###############################################################################
# Lifecycle
###############################################################################

remove_null_sink () {
    local module_id
    # Unload every null sink that carries our exact name - the one we loaded
    # plus any leftover from a previously crashed run.
    while IFS= read -r module_id; do
        [[ -n "$module_id" ]] || continue
        pactl unload-module "$module_id" 2>/dev/null || true
    done < <(_null_sink_module_ids)
}

cleanup () {
    _kill_spinner
    # "drain" so a manual quit mid-track still finalizes the current file.
    stop_current_recording "drain"
    if declare -F profile_cleanup >/dev/null 2>&1; then
        profile_cleanup
    fi
    remove_null_sink
    screen_leave
    printf '\033[0m'
    [[ -t 1 ]] && ui_clear
    [[ -n "$exit_note" ]] && printf '%s\n' "$exit_note" >&2
    return 0
}

###############################################################################
# CLI
#
# Deliberately minimal: everything else lives in the config file / TUI now.
# --output/--session/--format/--aac-profile/--bitrate/--scheme/--config were
# all removed for this - config_group_paths (Output Folder, Filename Scheme),
# config_group_codecs (Record Format, AAC Profile, Bitrate), and Session Name
# screen are the only way to set them any more.
###############################################################################

get_options () {
    local usage
    usage="$(t cli.usage "$SCRIPT_VERSION" "${0##*/}")"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)      log_level=2; shift ;;
            --help)       show_help=true; shift ;;
            --version)    show_version=true; shift ;;
            --logname)    [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; log_file_path="$2"; shift 2 ;;
            --logname=*)  log_file_path="${1#*=}"; shift ;;
            --) shift ;;
            -*) printf '%s\n' "$usage"; exit 1 ;;
            *)  printf '%s\n\n%s\n' "$(t cli.unknown_argument "$1")" "$usage"; exit 1 ;;
        esac
    done

    [[ "$show_help" == "true" ]] && { printf '%s\n' "$usage"; exit 0; }
    [[ "$show_version" == "true" ]] && { printf '%s\n' "$(t cli.version_line "$SCRIPT_VERSION")"; exit 0; }
    return 0
}

###############################################################################
# Internal worker used by the Recording Wizard's spinner (gum spin wraps this
# process so the wait animates with a real gum spinner and Ctrl+C cancels it
# like any other foreground command).
###############################################################################

_internal_wait () {
    local kind="$1"; shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config) config_path="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    load_config
    case "$kind" in
        sink)             until get_target_sink_index; do sleep 1; done ;;
        stopped|playing)  until profile_wait_condition "$kind"; do sleep 1; done ;;
        *)                return 1 ;;
    esac
}

###############################################################################
# Main
###############################################################################

main () {
    get_options "$@"
    check_dependencies
    require_tty "loopcatcher"

    ensure_config_dir
    load_config
    get_options "$@"          # CLI flags win over the config file
    [[ -n "$output_directory" ]] || { output_directory="$(default_music_dir)"; save_config; }
    validate_settings
    check_encoder_dependency

    welcome_screen
    initialize_output_directory
    session_name_screen
    check_audio_server
    init_session_log

    trap cleanup EXIT
    # A manual Ctrl+C on the Recording screen ends the session exactly like a
    # pause/stop signal or the player quitting would (end_session sets both
    # session_ended=true and should_exit=1) - not just should_exit=1 alone,
    # which broke recording_main_loop's wait but left session_ended false, so
    # the check below silently skipped the Finish screen instead of showing it.
    trap 'end_session' INT TERM

    profile_run

    [[ "$session_ended" == "true" ]] && finish_screen
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ "${1:-}" == "--internal-wait" ]]; then
        shift
        _internal_wait "$@"
        exit $?
    fi
    main "$@"
fi
