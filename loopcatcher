###############################################################################
# No-sink wizard
###############################################################################

_wizard_cancel () {
    printf 'Cancelled.\n' >&2
    exit 0
}

# Poll $1 (a command) every second until it succeeds; q / Ctrl-C cancels.
_wizard_wait_until () {
    local _k
    until "$@"; do
        [[ $should_exit -eq 1 ]] && _wizard_cancel
        IFS= read -rsn1 -t 1 _k && [[ "$_k" == [qQ] ]] && _wizard_cancel
    done
}

_playback_is_playing () {
    [[ "$(player_playback_status)" == "Playing" ]]
}

_playback_is_stopped () {
    [[ "$(player_playback_status)" != "Playing" ]]
}

no_sink_wizard () {
    require_tty "sink setup"
    local label
    label="$(player_profile_label "$player_profile")"

    # 1. Wait for the player sink-input to appear.
    wizard_step_screen "Step 1: Create the Audio Sink" \
        "1) Open your $label" \
        "2) Play any track that is NOT the first in your playlist or album you want to record"
    _wizard_wait_until get_target_sink_index

    # 2. Wait until playback is actually running (primes the sink + MPRIS).
    _wizard_wait_until _playback_is_playing

    # 3. Ask the user to pause, wait for it.
    wizard_step_screen "Step 2: Prepare to record" \
        "1) Pause the playback on your $label"
    _wizard_wait_until _playback_is_stopped
}

###############################################################################
# Menu / about / license
###############################################################################

pkg_meta_text () {
    local mode="${1:-about}" d
    if dpkg-query -W -f='${Version}' loopcatcher >/dev/null 2>&1; then
        printf '# loopcatcher (installed Debian package)\n\n'
        dpkg-query -W \
            -f='Version:     ${Version}\nMaintainer:  ${Maintainer}\nHomepage:    ${Homepage}\n\n${Description}\n' \
            loopcatcher
        if [[ "$mode" == "license" && -r /usr/share/doc/loopcatcher/copyright ]]; then
            printf '\n\n----- /usr/share/doc/loopcatcher/copyright -----\n\n'
            cat /usr/share/doc/loopcatcher/copyright
        fi
        return
    fi

    d="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    printf '# loopcatcher %s (running from source)\n\n' "$SCRIPT_VERSION"
    if [[ "$mode" == "about" && -r "$d/README.md" ]]; then
        head -n 40 "$d/README.md"
        printf '\n'
    fi
    if [[ -r "$d/LICENSE" ]]; then
        printf '\n----- LICENSE -----\n\n'
        cat "$d/LICENSE"
    else
        printf '(LICENSE not found)\n'
    fi
}

menu_action () {
    case "$1" in
        Config)          config_menu ;;
        "Reload config") reload_config ;;
        # gum pager runs its own alternate screen; drop back to the normal
        # screen around it so its exit does not leave us off our status buffer.
        About)           screen_leave; pkg_meta_text about   | gum pager --soft-wrap; screen_enter ;;
        License)         screen_leave; pkg_meta_text license | gum pager --soft-wrap; screen_enter ;;
        Quit)            should_exit=1 ;;
        *)               : ;;
    esac
}

open_menu () {
    local choice
    # Suppress WINCH so a resize cannot repaint the status view over the menu.
    # The menu draws on the same alternate screen as the status view (no screen
    # swap) so opening it costs one clear, not two screen transitions.
    trap '' WINCH
    ui_clear
    ui_title "loopcatcher  -  menu"
    printf '\n\n'
    # gum filter lets you type part of an option to pick it.
    choice="$(gum filter --header "Type to filter, Enter to select" --height 8 -- \
        "Resume" "Config" "Reload config" "About" "License" "Quit")" || choice="Resume"
    menu_action "$choice"
    trap 'status_dirty=1' WINCH
    status_chrome_init          # config menu may have moved output_directory
    _status_last_frame=""       # the menu overwrote the screen - force a repaint
    status_dirty=0
    status_render
}

###############################################################################
# Audio server / sink detection / routing
###############################################################################

check_audio_server () {
    if ! pactl info >/dev/null 2>&1; then
        printf 'FATAL: cannot connect to the PulseAudio/PipeWire session daemon.\n' >&2
        printf 'On KDE, ensure pipewire-pulse is running in your user session.\n' >&2
        printf 'Try: systemctl --user status pipewire pipewire-pulse wireplumber\n' >&2
        exit 1
    fi
}

is_target_sink_app () {
    local configured_name="$1" app_name="$2" pat
    local -a pats

    [[ -n "$configured_name" && "$app_name" == "$configured_name" ]] && return 0

    read -r -a pats <<< "$player_sink_match"
    for pat in "${pats[@]}"; do
        # Unquoted RHS on purpose: pat is a glob from the player profile.
        # shellcheck disable=SC2053
        [[ "${app_name,,}" == ${pat,,} ]] && return 0
    done
    return 1
}

# Sets source_sink_index. Returns: 0 matched, 2 no sink-inputs, 3 none matched.
get_target_sink_index () {
    local sink_list sink_index="" sink_app="" line

    sink_list="$(pactl list sink-inputs 2>/dev/null)"
    [[ -z "$sink_list" ]] && return 2

    while IFS= read -r line; do
        if [[ $line == "Sink Input #"* ]]; then
            sink_index="${line#Sink Input #}"
        elif [[ $line == *"application.name = "* ]]; then
            sink_app="$(cut -d '"' -f2 <<< "$line")"
            if is_target_sink_app "$sink_app_name" "$sink_app"; then
                source_sink_index="$sink_index"
                msg "Matched target sink: $sink_app" "debug"
                return 0
            fi
        fi
    done <<< "$sink_list"

    return 3
}

ensure_target_routed () {
    # Fast path: reuse the cached sink-input id (move-sink-input is idempotent).
    if [[ -n "$source_sink_index" ]] \
        && pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        return 0
    fi

    # Slow path: the player likely replaced its sink-input (e.g. track change).
    # Non-fatal so a transient failure does not kill the run.
    get_target_sink_index || return 1
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        msg "Could not move sink-input $source_sink_index to '$nulloutput_name'"
        return 1
    fi
    return 0
}

# Module ids of every loaded module-null-sink whose sink_name is exactly
# $nulloutput_name (an exact token match, so "loopcatcher" != "loopcatcher2").
_null_sink_module_ids () {
    pactl list short modules 2>/dev/null | awk -v want="sink_name=$nulloutput_name" '
        $2 == "module-null-sink" {
            n = split($0, tok, /[ \t]+/)
            for (i = 1; i <= n; i++) if (tok[i] == want) { print $1; break }
        }'
}

create_null_audio_output () {
    # Reuse an existing sink of our name (e.g. leftover from a crashed run);
    # otherwise load a fresh one. cleanup() unloads it either way.
    [[ -n "$(_null_sink_module_ids)" ]] && return 0
    if ! pactl load-module module-null-sink sink_name="$nulloutput_name" >/dev/null; then
        printf 'FATAL: cannot create null sink "%s".\n' "$nulloutput_name" >&2
        exit 1
    fi
}

move_target_output () {
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        printf 'FATAL: cannot move sink-input %s to "%s".\n' "$source_sink_index" "$nulloutput_name" >&2
        exit 1
    fi
}

###############################################################################
# Filename building
###############################################################################

sanitize_str () {
    if [[ "$1" == "strict" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2"
    elif [[ "$1" == "strict-lc" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2" | tr '[:upper:]' '[:lower:]'
    fi
}

# "normal" scheme component: keep Unicode letters/marks, strip only path-unsafe
# / FAT/NTFS-reserved chars so recordings to removable drives still work.
sanitize_component () {
    local s="$1"
    s="${s//\//_}"
    s="${s//\\/_}"
    s="${s//:/_}"
    s="${s//\*/_}"
    s="${s//\?/_}"
    s="${s//\"/_}"
    s="${s//</_}"
    s="${s//>/_}"
    s="${s//|/_}"
    # Fold whitespace to single spaces, then drop remaining ASCII control chars.
    # Byte-based, so UTF-8 multibyte sequences pass through untouched.
    s="$(printf '%s' "$s" | tr -s '[:space:]' ' ')"
    s="$(printf '%s' "$s" | tr -d '\000-\037\177')"
    s="${s#"${s%%[![:space:].]*}"}"
    s="${s%"${s##*[![:space:].]}"}"
    [[ -n "$s" ]] || s="Unknown"
    printf '%s' "$s"
}

unique_output_path () {
    local base="$1"
    [[ ! -e "$base" ]] && { printf '%s\n' "$base"; return; }

    local dir file ext stem n=2
    dir="$(dirname "$base")"
    file="$(basename "$base")"
    ext="${file##*.}"
    stem="${file%.*}"
    while [[ -e "$dir/${stem}_$n.$ext" ]]; do
        n=$((n + 1))
    done
    printf '%s\n' "$dir/${stem}_$n.$ext"
}

file_path_structure () {
    local i_artist="$1" i_album="$2" i_title="$3" extension="$4"
    local outdir outfile base

    case "$filename_scheme" in
        normal)
            outdir="$session_output_directory/$(sanitize_component "$i_artist")/$(sanitize_component "$i_album")"
            outfile="$(sanitize_component "$i_title").$extension"
            ;;
        strict)
            outdir="$session_output_directory/$(sanitize_str "strict" "$i_artist")/$(sanitize_str "strict" "$i_album")"
            outfile="$(sanitize_str "strict" "$i_title").$extension"
            ;;
        strict-lc-nodir)
            outdir="$session_output_directory"
            outfile="$(sanitize_str "strict-lc" "$i_artist")_$(sanitize_str "strict-lc" "$i_album")_$(sanitize_str "strict-lc" "$i_title").$extension"
            ;;
        *)
            # Unreachable: filename_scheme is validated at startup.
            printf 'FATAL: invalid filename_scheme %s\n' "$filename_scheme" >&2
            exit 1
            ;;
    esac

    mkdir -p -- "$outdir"
    base="$outdir/$outfile"
    unique_output_path "$base"
}

###############################################################################
# MPRIS monitor (player-scoped)
###############################################################################

# Runs as a coproc. Emits "key -> value" lines parsed by process_dbus_line.
# If the player-scoped match rule is rejected, retries once unscoped.
get_dbusmessages () {
    local rule="$1"
    local fallback="path=/org/mpris/MediaPlayer2,member=PropertiesChanged"
    local expect_key="" expect_type="" line started=0 attempt=0

    while :; do
        attempt=$((attempt + 1))
        while IFS= read -r line; do
            started=1
            case "$line" in
                *'string "PlaybackStatus"'*)     expect_key="playbackstatus"; expect_type="string"; continue ;;
                *'string "mpris:trackid"'*)      expect_key="trackid";        expect_type="string"; continue ;;
                *'string "xesam:album"'*)        expect_key="album";          expect_type="string"; continue ;;
                *'string "xesam:albumArtist"'*)  expect_key="albumartist";    expect_type="string"; continue ;;
                *'string "xesam:artist"'*)       expect_key="artist";         expect_type="string"; continue ;;
                *'string "xesam:discNumber"'*)   expect_key="discnumber";     expect_type="int32";  continue ;;
                *'string "xesam:title"'*)        expect_key="title";          expect_type="string"; continue ;;
                *'string "xesam:trackNumber"'*)  expect_key="tracknumber";    expect_type="int32";  continue ;;
            esac

            [[ -z "$expect_key" ]] && continue

            if [[ "$expect_type" == "string" ]] && [[ $line == *'string "'* ]]; then
                printf '%s -> %s\n' "$expect_key" "$(cut -d '"' -f2 <<< "$line")"
                expect_key=""; expect_type=""
            elif [[ "$expect_type" == "int32" ]] && [[ $line == *'int32 '* ]]; then
                printf '%s -> %s\n' "$expect_key" "$(awk '{print $2}' <<< "$line")"
                expect_key=""; expect_type=""
            fi
        done < <(dbus-monitor "$rule" 2>/dev/null)

        # dbus-monitor exited with no output at all -> the rule was rejected.
        # Retry once, unscoped (degraded: other MPRIS players may bleed in).
        if [[ $started -eq 0 && $attempt -eq 1 && "$rule" != "$fallback" ]]; then
            rule="$fallback"
            continue
        fi
        break
    done
}

###############################################################################
# Recording engine
###############################################################################

# stop_current_recording [quick|drain]
#   quick (default) - track change: stop capture and return immediately; the
#     encoder keeps running, sees EOF, finalizes its file and exits on its own.
#   drain           - session end: keep capturing for tail_drain_seconds, stop
#     capture, then wait for the encoder to finish writing the file.
stop_current_recording () {
    local mode="${1:-quick}"
    local fifo_dir="$record_fifo_dir"
    local old_encoder="$encoder_pid"
    local old_parec="$parec_pid"
    local waited=0

    [[ "$stopping_recording" == "true" ]] && return
    stopping_recording=true

    if [[ "$mode" == "drain" && -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        sleep "$tail_drain_seconds"
    fi

    # Stop capture first so the encoder gets EOF and can flush a clean trailer.
    if [[ -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        kill "$old_parec" 2>/dev/null || true
    fi

    parec_pid=""
    encoder_pid=""
    record_fifo_dir=""

    if [[ "$mode" == "drain" && -n "$old_encoder" ]]; then
        while kill -0 "$old_encoder" 2>/dev/null && [[ $waited -lt 60 ]]; do
            sleep 0.05
            waited=$((waited + 1))
        done
        if kill -0 "$old_encoder" 2>/dev/null; then
            kill "$old_encoder" 2>/dev/null || true
        fi
    fi

    # Safe to remove now: an unlinked FIFO / log stays valid for a background
    # encoder still finalizing (its output file lives elsewhere).
    [[ -n "$fifo_dir" && -d "$fifo_dir" ]] && rm -rf "$fifo_dir"
    [[ -n "$record_error_log" && -f "$record_error_log" ]] && rm -f "$record_error_log"
    record_error_log=""

    stopping_recording=false
}

start_recording () {
    local i_artist="$1" i_album="$2" i_title="$3" i_albumartist="$4" i_tracknumber="$5" i_discnumber="$6"
    local outputfile="" record_fifo="" ext

    [[ -z "$i_title" || -z "$i_artist" ]] && return 1

    ext="m4a"
    [[ "$record_format" == "ogg" ]] && ext="oga"
    outputfile="$(file_path_structure "$i_artist" "$i_album" "$i_title" "$ext")"
    stop_current_recording

    if ! ensure_target_routed; then
        msg "Could not route target sink to monitor output"
        return 1
    fi

    record_error_log="$(mktemp)"
    record_fifo_dir="$(mktemp -d)"
    record_fifo="$record_fifo_dir/pcm"
    if ! mkfifo "$record_fifo" 2>/dev/null; then
        msg "Could not create capture pipe under $record_fifo_dir"
        stop_current_recording
        return 1
    fi

    # Encoder first (blocks on the pipe until parec writes), then capture.
    # Separately tracked processes let us stop capture first on shutdown so the
    # encoder can flush and finalize instead of being killed mid-stream.
    case "$record_format" in
        aac)
            fdkaac -R -S -p "$aac_profile" --bitrate "${bitrate}k" --moov-before-mdat --afterburner 1 \
                --title "$i_title" --artist "$i_artist" --album "$i_album" --album-artist "$i_albumartist" \
                --track "$i_tracknumber" --disk "$i_discnumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        ogg)
            oggenc -b "$bitrate" --raw \
                --title "$i_title" --artist "$i_artist" --album "$i_album" --tracknum "$i_tracknumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        *)
            msg "Invalid record_format '$record_format'"
            stop_current_recording
            return 1
            ;;
    esac

    # Low capture latency keeps less audio stranded in the server buffer.
    parec -d "$nulloutput_name.monitor" --latency-msec=30 > "$record_fifo" 2>>"$record_error_log" &
    parec_pid=$!

    sleep 0.2
    if ! kill -0 "$parec_pid" 2>/dev/null || ! kill -0 "$encoder_pid" 2>/dev/null; then
        local err=""
        [[ -s "$record_error_log" ]] && err="$(tr '\n' ' ' < "$record_error_log")"
        kill "$parec_pid" "$encoder_pid" 2>/dev/null || true
        stop_current_recording
        [[ -n "$outputfile" ]] && rm -f "$outputfile"
        if [[ -n "$err" ]]; then
            msg "Recorder failed to start: $err"
        else
            msg "Recorder failed to start. Check codec dependencies and format settings."
        fi
        return 1
    fi

    tui_set "state" "recording"
    tui_set "output" "$outputfile"
    tui_set "message" "Recording '$i_title' by '$i_artist'"
    return 0
}

maybe_start_recording () {
    local signature

    [[ "$playbackstatus" != "Playing" ]] && return
    [[ -z "$title" || -z "$artist" ]] && return

    signature="${trackid:-$artist|$album|$title}"
    [[ "$signature" == "$active_recording_signature" ]] && return

    if start_recording "$artist" "$album" "$title" "$albumartist" "$tracknumber" "$discnumber"; then
        active_recording_signature="$signature"
    fi
}

process_dbus_line () {
    local dbus_read="$1"

    case "$dbus_read" in
        'playbackstatus -> '*)
            playbackstatus="${dbus_read#playbackstatus -> }"
            if [[ "$playbackstatus" == "Playing" ]]; then
                started_playing=true
                maybe_start_recording
            elif [[ "$started_playing" == "true" ]]; then
                # Any non-Playing state after playback began ends the session
                # (no half tracks; also where Spotify lands when a playlist
                # finishes). A pause before the first Playing is ignored.
                stop_current_recording "drain"
                active_recording_signature=""
                finish_session_and_exit "Playback '$playbackstatus'. Session finished."
            fi
            ;;
        'trackid -> '*)
            trackid="${dbus_read#trackid -> }"
            if [[ "$trackid" != "$last_trackid" ]]; then
                last_trackid="$trackid"
                active_recording_signature=""
                title="" artist="" album="" albumartist="" tracknumber="" discnumber=""
                stop_current_recording
                tui_set "state" "monitoring"
                tui_set "message" "Track change detected. Waiting for metadata..."
            fi
            maybe_start_recording
            ;;
        'title -> '*)       title="${dbus_read#title -> }";             tui_set "track" "$title";   maybe_start_recording ;;
        'artist -> '*)      artist="${dbus_read#artist -> }";           tui_set "artist" "$artist"; maybe_start_recording ;;
        'album -> '*)       album="${dbus_read#album -> }";             tui_set "album" "$album";   maybe_start_recording ;;
        'albumartist -> '*) albumartist="${dbus_read#albumartist -> }" ;;
        'tracknumber -> '*) tracknumber="${dbus_read#tracknumber -> }" ;;
        'discnumber -> '*)  discnumber="${dbus_read#discnumber -> }" ;;
    esac
}

###############################################################################
# Lifecycle
###############################################################################

remove_null_sink () {
    local module_id
    # Unload every null sink that carries our exact name - the one we loaded
    # plus any leftover from a previously crashed run.
    while IFS= read -r module_id; do
        [[ -n "$module_id" ]] || continue
        pactl unload-module "$module_id" 2>/dev/null || true
    done < <(_null_sink_module_ids)
}

cleanup () {
    # "drain" so a manual quit mid-track still finalizes the current file.
    stop_current_recording "drain"
    if [[ -n "$dbus_monitor_pid" ]] && kill -0 "$dbus_monitor_pid" 2>/dev/null; then
        kill "$dbus_monitor_pid" 2>/dev/null || true
    fi
    remove_null_sink
    screen_leave
    printf '\033[0m'

    if [[ "$status_active" == "true" && -t 1 ]]; then
        # The status view ran interactively - the "finished" screen already
        # showed the details, so just leave a clean terminal.
        ui_clear
    elif [[ "$tui_state" == "session-ended" ]]; then
        # Headless: no "finished" screen was shown, so print the summary.
        printf '%s\nFiles in: %s\n' "$tui_last_message" "${session_output_directory:-$output_directory}"
    fi
    [[ -n "$exit_note" ]] && printf '%s\n' "$exit_note" >&2
    return 0
}

###############################################################################
# CLI
###############################################################################

get_options () {
    local usage="loopcatcher v${SCRIPT_VERSION}

Usage: ${0##*/} [options]

Behavior:
  - If output-directory is omitted, first run uses the XDG Music folder and saves it.
  - Session name is asked interactively (prefilled with a timestamp; just press Enter).
    Provide --session to skip the prompt.
  - Output goes to: output-directory/session-name
  - Session ends automatically when playback becomes pause/stop.
  - First run only: a one-time gum onboarding wizard (player profile, codec, bitrate,
    filename scheme, output directory). It never reappears once the config file exists.

Options:
  --debug                   Enable debug logging
  --output <dir>            Output directory
  --session <name>          Session name (skips the prompt)
  --format <format>         Record format: aac or ogg
  --aac-profile <id>        AAC profile (aac only)
  --bitrate <kbps>          Bitrate target
  --scheme <scheme>         Filename scheme: normal, strict, strict-lc-nodir
  --config <path>           Override config file path
  --no-intro                Skip the first-run onboarding wizard (writes defaults)
  --help                    Show help
  --version                 Show version
"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)          debug=true; shift ;;
            --help)           show_help=true; shift ;;
            --version)        show_version=true; shift ;;
            --no-intro)       no_intro=true; shift ;;
            --output)         [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; output_directory="$2"; shift 2 ;;
            --output=*)       output_directory="${1#*=}"; shift ;;
            --session)        [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; session_name="$2"; shift 2 ;;
            --session=*)      session_name="${1#*=}"; shift ;;
            --aac-profile)    [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; aac_profile="$2"; shift 2 ;;
            --aac-profile=*)  aac_profile="${1#*=}"; shift ;;
            --bitrate)        [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; bitrate="$2"; shift 2 ;;
            --bitrate=*)      bitrate="${1#*=}"; shift ;;
            --config)         [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; config_path="$2"; config_dir="$(dirname "$config_path")"; shift 2 ;;
            --config=*)       config_path="${1#*=}"; config_dir="$(dirname "$config_path")"; shift ;;
            --format)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                record_format="$2"
                case "$record_format" in aac|ogg) ;; *) printf 'Invalid --format value: %s\n' "$record_format"; exit 1 ;; esac
                shift 2
                ;;
            --format=*)
                record_format="${1#*=}"
                case "$record_format" in aac|ogg) ;; *) printf 'Invalid --format value: %s\n' "$record_format"; exit 1 ;; esac
                shift
                ;;
            --scheme)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                filename_scheme="$2"
                case "$filename_scheme" in normal|strict|strict-lc-nodir) ;; *) printf 'Invalid --scheme value: %s\n' "$filename_scheme"; exit 1 ;; esac
                shift 2
                ;;
            --scheme=*)
                filename_scheme="${1#*=}"
                case "$filename_scheme" in normal|strict|strict-lc-nodir) ;; *) printf 'Invalid --scheme value: %s\n' "$filename_scheme"; exit 1 ;; esac
                shift
                ;;
            --) shift ;;
            -*) printf '%s\n' "$usage"; exit 1 ;;
            *)  printf 'Unknown argument: %s\n\n' "$1"; printf '%s\n' "$usage"; exit 1 ;;
        esac
    done

    [[ "$show_help" == "true" ]] && { printf '%s\n' "$usage"; exit 0; }
    [[ "$show_version" == "true" ]] && { printf 'loopcatcher version %s\n' "$SCRIPT_VERSION"; exit 0; }
    return 0
}

###############################################################################
# Main
###############################################################################

main_loop () {
    # Snapshot the coproc fd: bash may unset the DBUS_MONITOR array once the
    # coprocess exits, and "set -u" would then abort on ${DBUS_MONITOR[0]}.
    local dbus_fd="${DBUS_MONITOR[0]}"
    local got dbus_read key

    while [[ $should_exit -eq 0 ]]; do
        if ! kill -0 "$dbus_monitor_pid" 2>/dev/null; then
            exit_note="loopcatcher: dbus-monitor ended, session stopped."
            break
        fi

        got=0
        # Drain every line already buffered before repainting, so a metadata
        # burst (trackid + title + artist + album + the recorder's own setters)
        # collapses into ONE status_render instead of one per line.
        while IFS= read -r -t 0.2 -u "$dbus_fd" dbus_read 2>/dev/null; do
            process_dbus_line "$dbus_read"
            got=1
            [[ $should_exit -eq 0 ]] || break
        done

        if [[ $got -eq 0 && $should_exit -eq 0 ]]; then
            key=""
            read -rsn1 -t 0.05 key || true
            if [[ "$key" == [mM] ]]; then
                open_menu
            elif [[ "$key" == [qQ] && "$started_playing" != "true" ]]; then
                # Step 3 of the Recording Wizard: q cancels before the first play.
                should_exit=1
            fi
        fi

        # One repaint per tick, only when something changed (a setter or a
        # SIGWINCH set the flag). status_render itself no-ops an identical frame.
        if [[ $status_dirty -eq 1 && $should_exit -eq 0 ]]; then
            status_dirty=0
            status_render
        fi
    done
}

main () {
    get_options "$@"
    check_dependencies

    local config_existed=0
    [[ -f "$config_path" ]] && config_existed=1
    ensure_config_dir
    load_config
    get_options "$@"          # CLI flags win over the config file
    validate_settings
    check_encoder_dependency

    if [[ $config_existed -eq 0 ]]; then
        if [[ "$no_intro" != "true" && -t 0 && -t 1 ]]; then
            onboarding_wizard
            load_config          # re-read the normalized values
        else
            save_config          # headless / --no-intro first run: write defaults
        fi
    fi

    initialize_output_directory
    session_name_step
    check_audio_server

    trap cleanup EXIT
    trap 'should_exit=1' INT TERM

    get_target_sink_index || no_sink_wizard

    create_null_audio_output
    move_target_output

    status_chrome_init
    status_active=true
    screen_enter
    trap 'status_dirty=1' WINCH

    tui_state="monitoring"
    tui_last_message="Monitoring MPRIS for $(player_profile_label "$player_profile")..."
    status_dirty=0
    status_render          # first paint is direct; the loop repaints on change

    coproc DBUS_MONITOR { get_dbusmessages "path=/org/mpris/MediaPlayer2,member=PropertiesChanged,sender=$player_mpris_bus"; }
    dbus_monitor_pid=$!

    main_loop
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
