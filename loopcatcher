#!/bin/bash
##############################################################################
# Record system audio loopback to AAC or OGG
##############################################################################

set -u
set -o pipefail

if [[ $EUID -eq 0 ]]; then
    echo "This script must not be run as root"
    exit 1
fi

debug=false
tui_last_message=""
tui_state="starting"
tui_track="-"
tui_artist="-"
tui_album="-"
tui_output="-"
tui_hint="q quit  ·  c config  ·  r reload"
tui_cols=80
tui_frame=0
tui_spinner=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
tui_screen_active=false

source_sink_index=""
created_null_sink=false
nullsink_module_id=""
should_exit=0
started_playing=false
parec_pid=""
encoder_pid=""
record_fifo_dir=""
stopping_recording=false
dbus_monitor_pid=""
record_error_log=""
exit_note=""
show_help=false
show_version=false
exit_on_any_key=false
no_intro=false

sink_app_name="spotify"
nulloutput_name="loopcatcher"
aac_profile="29"
bitrate="48"
record_format="aac"
filename_scheme="normal"
output_directory=""
# Extra capture time (seconds) kept running after the player reports
# pause/stop, so the audio tail still moving through the
# sink -> parec -> pipe -> encoder chain is written instead of cut.
# Trade-off: up to this much near-silence at the end of the last track.
# 0 disables it. Editable from the config menu.
tail_drain_seconds="0.35"

session_name=""
session_output_directory=""
playbackstatus="Unknown"
active_recording_signature=""

trackid=""
last_trackid=""
title=""
artist=""
album=""
albumartist=""
tracknumber=""
discnumber=""

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$XDG_CONFIG_HOME/loopcatcher"
config_path="$config_dir/config"

get_script_version () {
    local script_dir
    local version_file
    local file_version

    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    for version_file in "$script_dir/VERSION" "/usr/share/loopcatcher/VERSION"; do
        if [[ -r "$version_file" ]]; then
            IFS= read -r file_version < "$version_file"
            printf '%s\n' "$file_version"
            return
        fi
    done

    printf '%s\n' "0.0-dev"
}

SCRIPT_VERSION="$(get_script_version)"

msg () {
    if [[ "${2:-}" == "debug" ]]; then
        if [[ "$debug" == "true" || "$debug" == "yes" ]]; then
            printf '\033[0;31mDEBUG: %s\033[0m\n' "$1" 1>&2
        fi
        return
    fi

    tui_last_message="$1"
    tui_render
}

wait_for_any_key_then_exit () {
    exit_on_any_key=true
    should_exit=0
    tui_set "state" "session-ended"
    tui_set "message" "$1"
    tui_hint="Press any key to exit"
}

show_blocking_notice_and_exit () {
    tui_set "state" "setup-required"
    tui_set "message" "$1"
    tui_hint="Press any key to exit"
    read -rsn1 _ignore
    exit 1
}

show_startup_info () {
    tui_measure_cols
    tui_page_header "welcome"

    printf ' This session will:\n'
    printf '   🎙️  Capture app/system audio through a Linux loopback monitor sink\n'
    printf '   💾  Save files under  output_directory/session_name\n'
    printf '   ⏹️  Stop automatically as soon as playback pauses or stops\n'
    tui_hr
    printf ' Recommended flow:\n'
    printf '   \033[1m1\033[0m  Play any track once in your player (creates the sink)\n'
    printf '   \033[1m2\033[0m  Pause, then select the first track you want to record\n'
    printf '   \033[1m3\033[0m  Launch loopcatcher (this screen) while still paused\n'
    printf '   \033[1m4\033[0m  Press Play — recording starts on the metadata refresh\n'
    tui_hr
    printf '   \033[1;33m⚠\033[0m  \033[2mOnce playing, ANY pause/stop ends the session (no half\n'
    printf '      tracks) — also where Spotify lands when a playlist ends.\033[0m\n'
    tui_hr
    printf '   \033[2mKeys:\033[0m  c config   \033[2m·\033[0m   r reload   \033[2m·\033[0m   q quit\n'
    tui_hr_heavy
    printf ' \033[2m›\033[0m Press Enter to continue… '
    read -r _ignore
}

tui_measure_cols () {
    tui_cols="$(tput cols 2>/dev/null || echo 80)"
    { [[ "$tui_cols" =~ ^[0-9]+$ ]] && [[ "$tui_cols" -ge 40 ]]; } || tui_cols=80
}

tui_enter_screen () {
    tui_measure_cols
    tui_screen_active=true
    # Alternate screen buffer + hidden cursor: no scrollback pollution and a
    # clean, fl"icker-free surface to repaint in place.
    printf '\033[?1049h\033[?25l'
}

tui_leave_screen () {
    if [[ "$tui_screen_active" == "true" ]]; then
        printf '\033[?25h\033[?1049l'
        tui_screen_active=false
    fi
}

tui_resize () {
    tui_measure_cols
    tui_render
}

# Shared chrome for the full-screen sub-pages (onboarding, prompts, menus)
# so they carry the same look as the recording dashboard.
tui_hr () {
    local w="$tui_cols" rule
    [[ "$w" -ge 40 ]] 2>/dev/null || w=40
    printf -v rule '%*s' "$w" ''
    printf '\033[36m%s\033[0m\n' "${rule// /─}"
}

tui_hr_heavy () {
    local w="$tui_cols" rule
    [[ "$w" -ge 40 ]] 2>/dev/null || w=40
    printf -v rule '%*s' "$w" ''
    printf '\033[1;36m%s\033[0m\n' "${rule// /━}"
}

tui_page_header () {
    local subtitle="${1:-}"
    local w="$tui_cols" rule
    [[ "$w" -ge 40 ]] 2>/dev/null || w=40
    printf -v rule '%*s' "$w" ''
    printf '\033[H\033[2J'
    printf '\033[1;36m%s\033[0m\n' "${rule// /━}"
    if [[ -n "$subtitle" ]]; then
        printf ' \033[1m🎧 loopcatcher\033[0m \033[2m·\033[0m %s   \033[2mv%s\033[0m\n' "$subtitle" "$SCRIPT_VERSION"
    else
        printf ' \033[1m🎧 loopcatcher\033[0m   \033[2mv%s\033[0m\n' "$SCRIPT_VERSION"
    fi
    printf '\033[1;36m%s\033[0m\n' "${rule// /━}"
}

tui_render () {
    local w="$tui_cols"
    local rule_heavy rule_light state_disp play_disp spin msg_prefix out
    local esc=$'\033'
    local eol=$'\033[K\n'
    local cyan=$'\033[1;36m' dim=$'\033[2m' rst=$'\033[0m'

    [[ "$w" -ge 40 ]] 2>/dev/null || w=40
    printf -v rule_heavy '%*s' "$w" ''
    rule_heavy="${rule_heavy// /━}"
    printf -v rule_light '%*s' "$w" ''
    rule_light="${rule_light// /─}"

    spin="${tui_spinner[tui_frame % ${#tui_spinner[@]}]}"
    case "$tui_state" in
        recording)      state_disp="${esc}[1;32m⏺ recording${rst} ${spin}" ; msg_prefix="${spin}  " ;;
        monitoring)     state_disp="${dim}◌ monitoring${rst}" ; msg_prefix="${dim}·${rst}  " ;;
        session-ended)  state_disp="${esc}[1;33m⏹ session ended${rst}" ; msg_prefix="${dim}·${rst}  " ;;
        setup-required) state_disp="${esc}[1;31m⚠ setup required${rst}" ; msg_prefix="${dim}·${rst}  " ;;
        *)              state_disp="${dim}… ${tui_state}${rst}" ; msg_prefix="${dim}·${rst}  " ;;
    esac

    case "$playbackstatus" in
        Playing) play_disp="${esc}[32m▶${rst} Playing" ;;
        Paused)  play_disp='⏸ Paused' ;;
        Stopped) play_disp='■ Stopped' ;;
        *)       play_disp="• ${playbackstatus}" ;;
    esac

    out="${esc}[H"
    out+="${cyan}${rule_heavy}${rst}${eol}"
    out+=" 🎧  ${esc}[1mloopcatcher${rst}  ${dim}v${SCRIPT_VERSION}${rst}${eol}"
    out+=" ${state_disp}      ${play_disp}${eol}"
    out+="${esc}[36m${rule_light}${rst}${eol}"
    out+=" 🎵  Track    ${tui_track:--}${eol}"
    out+=" 🎤  Artist   ${tui_artist:--}${eol}"
    out+=" 💿  Album    ${tui_album:--}${eol}"
    out+=" 🎯  Sink     ${source_sink_index:--}${eol}"
    out+=" 📇  Session  ${session_name:--}${eol}"
    out+=" 📂  Folder   ${session_output_directory:--}${eol}"
    out+=" 💾  File     ${tui_output:--}${eol}"
    out+=" 🔧  Config   ${config_path}${eol}"
    out+="${esc}[36m${rule_light}${rst}${eol}"
    out+=" ${msg_prefix}${tui_last_message}${eol}"
    out+="${esc}[36m${rule_light}${rst}${eol}"
    out+=" ${dim}${tui_hint}${rst}${eol}"
    out+="${esc}[J"
    printf '%s' "$out"
}

check_dependencies () {
    local requirements='tr dbus-monitor pactl parec tput mktemp mkfifo awk'
    local req
    for req in $requirements; do
        if ! command -v "$req" >/dev/null 2>&1; then
            echo "FATAL: \"$req\" was not found"
            exit 1
        fi
    done
}

check_encoder_dependency () {
    local tool
    case "$record_format" in
        aac) tool="fdkaac" ;;
        ogg) tool="oggenc" ;;
        *) return ;;
    esac
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'FATAL: "%s" is required for record_format=%s but was not found\n' "$tool" "$record_format"
        exit 1
    fi
}

ensure_config_dir () {
    mkdir -p "$config_dir"
    if [[ ! -f "$config_path" ]]; then
        save_config
    fi
}

load_config () {
    if [[ -r "$config_path" ]]; then
        # shellcheck disable=SC1090
        source "$config_path"
    fi

    if [[ -n "${recordformat:-}" ]]; then
        record_format="$recordformat"
    fi
    if [[ -n "${filenamescheme:-}" ]]; then
        filename_scheme="$filenamescheme"
    fi
}

save_config () {
    cat > "$config_path" <<EOF
# loopcatcher config
debug="$debug"
sink_app_name="$sink_app_name"
nulloutput_name="$nulloutput_name"
aac_profile="$aac_profile"
bitrate="$bitrate"
record_format="$record_format"
filename_scheme="$filename_scheme"
output_directory="$output_directory"
tail_drain_seconds="$tail_drain_seconds"
EOF
}

reload_config () {
    load_config
    validate_settings
    tui_set "message" "Configuration reloaded from $config_path"
}

validate_settings () {
    case "$record_format" in
        aac|ogg) ;;
        *)
            printf 'Invalid record format: %s (allowed: aac, ogg)\n' "$record_format"
            exit 1
            ;;
    esac

    case "$filename_scheme" in
        normal|strict|strict-lc-nodir) ;;
        *)
            printf 'Invalid filename scheme: %s (allowed: normal, strict, strict-lc-nodir)\n' "$filename_scheme"
            exit 1
            ;;
    esac

    if [[ ! "$bitrate" =~ ^[0-9]+$ ]] || [[ "$bitrate" -le 0 ]]; then
        printf 'Invalid bitrate: %s (must be a positive integer)\n' "$bitrate"
        exit 1
    fi

    if [[ ! "$aac_profile" =~ ^[0-9]+$ ]] || [[ "$aac_profile" -le 0 ]]; then
        printf 'Invalid aac_profile: %s (must be a positive integer)\n' "$aac_profile"
        exit 1
    fi

    if [[ ! "$tail_drain_seconds" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf 'Invalid tail_drain_seconds: %s (must be a non-negative number, e.g. 0.35)\n' "$tail_drain_seconds"
        exit 1
    fi

    case "$debug" in
        true|false|yes|no) ;;
        *)
            printf 'Invalid debug value: %s (allowed: true, false, yes, no)\n' "$debug"
            exit 1
            ;;
    esac
}

tui_set () {
    local key="$1"
    local value="$2"
    case "$key" in
        state) tui_state="$value" ;;
        track) tui_track="$value" ;;
        artist) tui_artist="$value" ;;
        album) tui_album="$value" ;;
        output) tui_output="$value" ;;
        message) tui_last_message="$value" ;;
    esac
    tui_render
}

browse_directory () {
    local current="$1"
    local options=()
    local idx=1
    local choice=""
    local selected

    if [[ ! -d "$current" ]]; then
        current="$HOME"
    fi

    tui_measure_cols
    while true; do
        tui_page_header "directory browser"
        printf ' 📂  %s\n' "$current"
        tui_hr

        options=()
        shopt -s nullglob dotglob
        for selected in "$current"/*/; do
            options+=("${selected%/}")
        done
        shopt -u nullglob dotglob

        if [[ ${#options[@]} -eq 0 ]]; then
            printf ' \033[2m(no subdirectories here)\033[0m\n'
        else
            idx=1
            for selected in "${options[@]}"; do
                printf '  \033[1m%2s\033[0m  %s/\n' "$idx" "$(basename "$selected")"
                idx=$((idx + 1))
            done
        fi

        tui_hr_heavy
        printf ' \033[2mnumber\033[0m open   \033[2mu\033[0m up   \033[2ms\033[0m select here   \033[2mq\033[0m cancel\n'
        printf ' \033[2m›\033[0m Choose: '
        read -r choice

        case "$choice" in
            u|U) current="$(dirname "$current")" ;;
            s|S) echo "$current" ; return 0 ;;
            q|Q) return 1 ;;
            *)
                if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le ${#options[@]} ]]; then
                    current="${options[$((choice - 1))]}"
                fi
                ;;
        esac
    done
}

default_music_dir () {
    local music_dir=""
    if command -v xdg-user-dir >/dev/null 2>&1; then
        music_dir="$(xdg-user-dir MUSIC 2>/dev/null || true)"
        if [[ -n "$music_dir" ]]; then
            echo "$music_dir"
            return
        fi
    fi

    if [[ -f "$HOME/.config/user-dirs.dirs" ]]; then
        music_dir=$(grep '^XDG_MUSIC_DIR=' "$HOME/.config/user-dirs.dirs" | cut -d'=' -f2 | tr -d '"')
        music_dir="${music_dir//\$HOME/$HOME}"
        if [[ -n "$music_dir" ]]; then
            echo "$music_dir"
            return
        fi
    fi

    echo "$HOME/Music"
}

initialize_output_directory () {
    local selected
    if [[ -n "$output_directory" ]]; then
        mkdir -p "$output_directory"
        return
    fi

    output_directory="$(default_music_dir)"
    if [[ -n "$output_directory" ]]; then
        mkdir -p "$output_directory"
        save_config
        msg "Output directory initialized to $output_directory"
        return
    fi

    if selected="$(browse_directory "$HOME")"; then
        output_directory="$selected"
        mkdir -p "$output_directory"
        save_config
        msg "Output directory set to $output_directory"
    else
        msg "No output directory selected. Exiting..."
        exit 1
    fi
}

choose_output_directory () {
    local choice=""
    local selected=""
    tui_measure_cols
    tui_page_header "output directory"
    printf ' 📂  Current   %s\n' "$output_directory"
    tui_hr
    printf '  \033[1m1\033[0m  Type a path manually\n'
    printf '  \033[1m2\033[0m  Browse directories\n'
    tui_hr_heavy
    printf ' \033[2m›\033[0m Choose: '
    read -r choice

    case "$choice" in
        1)
            printf ' \033[2m›\033[0m Path: '
            read -r selected
            if [[ -n "$selected" ]]; then
                output_directory="$selected"
            fi
            ;;
        2)
            if selected="$(browse_directory "$output_directory")"; then
                output_directory="$selected"
            fi
            ;;
    esac

    if [[ -n "$output_directory" ]]; then
        mkdir -p "$output_directory"
        save_config
        msg "Output directory updated: $output_directory"
    fi
}

prompt_session_name () {
    local value="${session_name:-}"
    local candidate=""
    local validation_error=""

    if [[ -n "$value" ]]; then
        if [[ "$value" == *"/"* ]]; then
            msg "Invalid session name from CLI: cannot include '/'"
            exit 1
        fi
        candidate="$output_directory/$value"
        if [[ -d "$candidate" ]] && [[ -n "$(ls -A "$candidate" 2>/dev/null)" ]]; then
            msg "Session folder from CLI exists and is not empty: $candidate"
            exit 1
        fi
        session_name="$value"
        session_output_directory="$candidate"
        mkdir -p "$session_output_directory"
        tui_set "message" "Session selected from CLI: $session_name"
        return
    fi

    tui_measure_cols
    while true; do
        tui_page_header "session setup"
        printf ' 📂  Base folder   %s\n' "$output_directory"
        tui_hr
        printf ' 📇  Session name\n'
        printf '     \033[2m·\033[0m groups this run under  output_directory/session_name\n'
        printf '     \033[2m·\033[0m tip: date-purpose, e.g. 2026-08-28-album\n'
        tui_hr
        printf ' \033[1;33m⚠\033[0m  \033[2mDisable in your player so the session can end cleanly\n'
        printf '    when the playlist/album ends:\033[0m  Autoplay \033[2m·\033[0m Crossfade \033[2m·\033[0m Gapless\n'
        tui_hr_heavy
        if [[ -n "$validation_error" ]]; then
            printf ' \033[1;31m✗\033[0m %s\n' "$validation_error"
            tui_hr
        fi
        printf ' \033[2m›\033[0m Enter session name (required): '
        read -r value

        if [[ -z "$value" ]]; then
            validation_error="Session name cannot be empty"
            continue
        fi
        if [[ "$value" == *"/"* ]]; then
            validation_error="Session name cannot include '/'"
            continue
        fi

        candidate="$output_directory/$value"
        if [[ -d "$candidate" ]] && [[ -n "$(ls -A "$candidate" 2>/dev/null)" ]]; then
            validation_error="Session folder exists and is not empty: $candidate"
            continue
        fi

        validation_error=""
        session_name="$value"
        session_output_directory="$candidate"
        mkdir -p "$session_output_directory"
        tui_set "message" "Session selected: $session_name"
        return
    done
}

config_prompt_value () {
    local var_name="$1"
    local label="$2"
    local current_value
    local new_value=""
    current_value="${!var_name}"
    printf ' \033[2m›\033[0m %s \033[2m[%s]\033[0m: ' "$label" "$current_value"
    read -r new_value
    if [[ -n "$new_value" ]]; then
        printf -v "$var_name" '%s' "$new_value"
    fi
}

open_config_menu () {
    local opt=""
    local status=""
    tui_measure_cols
    while true; do
        tui_page_header "config"
        printf ' 🔧  %s\n' "$config_path"
        if [[ -n "$status" ]]; then
            printf ' \033[1;32m%s\033[0m\n' "$status"
            status=""
        fi
        tui_hr
        printf '  \033[1m1\033[0m  record_format       %s\n' "$record_format"
        printf '     \033[2mOutput codec. aac → .m4a, ogg → .oga\033[0m\n'
        printf '  \033[1m2\033[0m  bitrate             %s\n' "$bitrate"
        printf '     \033[2mEncoding bitrate in kbps. e.g. 48 (AAC HE v2); raise to 128+ for OGG\033[0m\n'
        printf '  \033[1m3\033[0m  aac_profile         %s\n' "$aac_profile"
        printf '     \033[2mfdkaac profile (used only when record_format=aac)\033[0m\n'
        printf '  \033[1m4\033[0m  filename_scheme     %s\n' "$filename_scheme"
        printf '     \033[2mnormal (keeps Unicode) / strict / strict-lc-nodir\033[0m\n'
        printf '  \033[1m5\033[0m  output_directory    %s\n' "$output_directory"
        printf '     \033[2mBase folder where each session folder is created\033[0m\n'
        printf '  \033[1m6\033[0m  sink_app_name       %s\n' "$sink_app_name"
        printf '     \033[2mApp name in the audio sink (ex: spotify, com.spotify.Client)\033[0m\n'
        printf '  \033[1m7\033[0m  nulloutput_name     %s\n' "$nulloutput_name"
        printf '     \033[2mVirtual sink name used for monitor recording\033[0m\n'
        printf '  \033[1m8\033[0m  debug               %s\n' "$debug"
        printf '     \033[2mtrue/false to show internal debug logs\033[0m\n'
        printf '  \033[1m9\033[0m  tail_drain_seconds  %s\n' "$tail_drain_seconds"
        printf '     \033[2mExtra capture time after playback stops so the tail is not cut (0 = off)\033[0m\n'
        tui_hr
        printf '  \033[1ms\033[0m  save        \033[1mx\033[0m  save & exit\n'
        tui_hr_heavy
        printf ' \033[2m›\033[0m Choose: '
        read -r opt

        case "$opt" in
            1) config_prompt_value "record_format" "record_format (aac|ogg)" ;;
            2) config_prompt_value "bitrate" "bitrate" ;;
            3) config_prompt_value "aac_profile" "aac_profile" ;;
            4) config_prompt_value "filename_scheme" "filename_scheme (normal|strict|strict-lc-nodir)" ;;
            5) choose_output_directory ;;
            6) config_prompt_value "sink_app_name" "sink_app_name" ;;
            7) config_prompt_value "nulloutput_name" "nulloutput_name" ;;
            8) config_prompt_value "debug" "debug (true|false)" ;;
            9) config_prompt_value "tail_drain_seconds" "tail_drain_seconds (seconds, e.g. 0.35)" ;;
            s)
                save_config
                status="✓ saved"
                ;;
            x)
                save_config
                break
                ;;
        esac
    done
    tui_set "message" "Exited configuration menu"
}

check_audio_server () {
    if ! pactl info >/dev/null 2>&1; then
        printf 'FATAL: cannot connect to the PulseAudio/PipeWire session daemon.\n' >&2
        printf 'On KDE, ensure pipewire-pulse is running in your user session.\n' >&2
        printf 'Try: systemctl --user status pipewire pipewire-pulse wireplumber\n' >&2
        exit 1
    fi
}

is_target_sink_app () {
    local configured_name="$1"
    local app_name="$2"
    if [[ -n "$configured_name" ]] && [[ "$app_name" == "$configured_name" ]]; then
        return 0
    fi
    case "${app_name,,}" in
        spotify|spotify*) return 0 ;;
        com.spotify.client|com.spotify.client*) return 0 ;;
    esac
    return 1
}

get_target_sink_index () {
    local sink_list
    local sink_index=""
    local sink_app=""
    local line

    sink_list="$(pactl list sink-inputs 2>/dev/null)"
    if [[ -z "$sink_list" ]]; then
        return 2
    fi

    while IFS= read -r line; do
        if [[ $line == "Sink Input #"* ]]; then
            sink_index="${line#Sink Input #}"
        elif [[ $line == *"application.name = "* ]]; then
            sink_app="$(cut -d '"' -f2 <<< "$line")"
            if is_target_sink_app "$sink_app_name" "$sink_app"; then
                source_sink_index="$sink_index"
                msg "Matched target sink: $sink_app" "debug"
                return 0
            fi
        fi
    done <<< "$sink_list"

    return 3
}

ensure_target_routed () {
    # Fast path: reuse the cached sink-input id with a single cheap call.
    # move-sink-input is idempotent, so this is a no-op when already routed.
    if [[ -n "$source_sink_index" ]] \
        && pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        return 0
    fi

    # Slow path: the player likely replaced its sink-input (e.g. on a track
    # change) - rescan. Non-fatal so a transient failure does not kill the run.
    if ! get_target_sink_index; then
        return 1
    fi
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        msg "Could not move sink-input $source_sink_index to '$nulloutput_name'"
        return 1
    fi
    return 0
}

create_null_audio_output () {
    nullsink_module_id="$(pactl list short modules | grep "module-null-sink" | grep "sink_name=$nulloutput_name" | cut -f1 | head -n 1)"
    if [[ -z "$nullsink_module_id" ]]; then
        if ! nullsink_module_id="$(pactl load-module module-null-sink sink_name="$nulloutput_name")"; then
            printf 'FATAL: cannot create null sink "%s".\n' "$nulloutput_name" >&2
            exit 1
        fi
        created_null_sink=true
    fi
}

move_target_output () {
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        printf 'FATAL: cannot move sink-input %s to "%s".\n' "$source_sink_index" "$nulloutput_name" >&2
        exit 1
    fi
}

sanitize_str () {
    if [[ "$1" == "strict" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2"
    elif [[ "$1" == "strict-lc" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2" | tr '[:upper:]' '[:lower:]'
    fi
}

# Path component for the "normal" scheme: keep Unicode letters/marks intact,
# only remove characters that are unsafe in a path or reserved on common
# filesystems (so recordings to FAT/exFAT/NTFS drives still work).
sanitize_component () {
    local s="$1"
    s="${s//\//_}"
    s="${s//\\/_}"
    s="${s//:/_}"
    s="${s//\*/_}"
    s="${s//\?/_}"
    s="${s//\"/_}"
    s="${s//</_}"
    s="${s//>/_}"
    s="${s//|/_}"
    # Fold every whitespace kind (tab, newline, ...) to single spaces, then
    # drop any remaining ASCII control chars. Byte-based, so UTF-8 multibyte
    # sequences pass through untouched.
    s="$(printf '%s' "$s" | tr -s '[:space:]' ' ')"
    s="$(printf '%s' "$s" | tr -d '\000-\037\177')"
    s="${s#"${s%%[![:space:].]*}"}"
    s="${s%"${s##*[![:space:].]}"}"
    [[ -n "$s" ]] || s="Unknown"
    printf '%s' "$s"
}

unique_output_path () {
    local base="$1"
    if [[ ! -e "$base" ]]; then
        echo "$base"
        return
    fi

    local dir
    local file
    local ext
    local stem
    local n=2

    dir="$(dirname "$base")"
    file="$(basename "$base")"
    ext="${file##*.}"
    stem="${file%.*}"

    while [[ -e "$dir/${stem}_$n.$ext" ]]; do
        n=$((n + 1))
    done
    echo "$dir/${stem}_$n.$ext"
}

file_path_structure () {
    local i_artist="$1"
    local i_album="$2"
    local i_title="$3"
    local extension="$4"
    local outdir
    local outfile
    local base

    case "$filename_scheme" in
        normal)
            outdir="$session_output_directory/$(sanitize_component "$i_artist")/$(sanitize_component "$i_album")"
            outfile="$(sanitize_component "$i_title").$extension"
            ;;
        strict)
            outdir="$session_output_directory/$(sanitize_str "strict" "$i_artist")/$(sanitize_str "strict" "$i_album")"
            outfile="$(sanitize_str "strict" "$i_title").$extension"
            ;;
        strict-lc-nodir)
            outdir="$session_output_directory"
            outfile="$(sanitize_str "strict-lc" "$i_artist")_$(sanitize_str "strict-lc" "$i_album")_$(sanitize_str "strict-lc" "$i_title").$extension"
            ;;
        *)
            msg "FATAL: invalid filename_scheme '$filename_scheme'"
            exit 1
            ;;
    esac

    mkdir -p "$outdir"
    base="$outdir/$outfile"
    unique_output_path "$base"
}

get_dbusmessages () {
    local expect_key=""
    local expect_type=""
    local line

    while IFS= read -r line; do
        case "$line" in
            *'string "PlaybackStatus"'*)
                expect_key="playbackstatus"
                expect_type="string"
                continue
                ;;
            *'string "mpris:trackid"'*)
                expect_key="trackid"
                expect_type="string"
                continue
                ;;
            *'string "xesam:album"'*)
                expect_key="album"
                expect_type="string"
                continue
                ;;
            *'string "xesam:albumArtist"'*)
                expect_key="albumartist"
                expect_type="string"
                continue
                ;;
            *'string "xesam:artist"'*)
                expect_key="artist"
                expect_type="string"
                continue
                ;;
            *'string "xesam:discNumber"'*)
                expect_key="discnumber"
                expect_type="int32"
                continue
                ;;
            *'string "xesam:title"'*)
                expect_key="title"
                expect_type="string"
                continue
                ;;
            *'string "xesam:trackNumber"'*)
                expect_key="tracknumber"
                expect_type="int32"
                continue
                ;;
        esac

        if [[ -z "$expect_key" ]]; then
            continue
        fi

        if [[ "$expect_type" == "string" ]] && [[ $line == *'string "'* ]]; then
            echo "$expect_key -> $(cut -d '"' -f2 <<< "$line")"
            expect_key=""
            expect_type=""
            continue
        fi

        if [[ "$expect_type" == "int32" ]] && [[ $line == *'int32 '* ]]; then
            echo "$expect_key -> $(awk '{print $2}' <<< "$line")"
            expect_key=""
            expect_type=""
            continue
        fi
    done < <(dbus-monitor "$1")
}

# stop_current_recording [mode]
#   quick (default) - track change / handoff: stop capture and return
#     immediately; the encoder keeps running in the background, sees EOF
#     (parec is gone), finalizes its file and exits on its own. This keeps
#     track-to-track gaps as short as possible.
#   drain           - session end: keep capturing for tail_drain_seconds so
#     the in-flight audio tail is not cut, then stop capture and wait for the
#     encoder to finish writing the file before returning.
stop_current_recording () {
    local mode="${1:-quick}"
    local fifo_dir="$record_fifo_dir"
    local old_encoder="$encoder_pid"
    local old_parec="$parec_pid"
    local waited=0

    if [[ "$stopping_recording" == "true" ]]; then
        return
    fi
    stopping_recording=true

    if [[ "$mode" == "drain" ]] && [[ -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        sleep "$tail_drain_seconds"
    fi

    # Stop capture first: the encoder then gets EOF and can flush its
    # remaining frames and write a clean container trailer.
    if [[ -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        kill "$old_parec" 2>/dev/null || true
    fi

    parec_pid=""
    encoder_pid=""
    record_fifo_dir=""

    if [[ "$mode" == "drain" ]] && [[ -n "$old_encoder" ]]; then
        # Shutting down: wait for the encoder to finalize the file.
        while kill -0 "$old_encoder" 2>/dev/null && [[ $waited -lt 60 ]]; do
            sleep 0.05
            waited=$((waited + 1))
        done
        if kill -0 "$old_encoder" 2>/dev/null; then
            kill "$old_encoder" 2>/dev/null || true
        fi
    fi

    # Safe to remove now: an unlinked FIFO / log stays valid for any encoder
    # still finalizing in the background (its output file lives elsewhere).
    if [[ -n "$fifo_dir" ]] && [[ -d "$fifo_dir" ]]; then
        rm -rf "$fifo_dir"
    fi
    if [[ -n "$record_error_log" ]] && [[ -f "$record_error_log" ]]; then
        rm -f "$record_error_log"
    fi
    record_error_log=""

    stopping_recording=false
}

start_recording () {
    local i_artist="$1"
    local i_album="$2"
    local i_title="$3"
    local i_albumartist="$4"
    local i_tracknumber="$5"
    local i_discnumber="$6"
    local outputfile=""
    local record_fifo=""

    if [[ -z "$i_title" || -z "$i_artist" ]]; then
        return 1
    fi

    outputfile="$(file_path_structure "$i_artist" "$i_album" "$i_title" "$([[ "$record_format" == "ogg" ]] && echo "oga" || echo "m4a")")"
    stop_current_recording

    if ! ensure_target_routed; then
        msg "Could not route target sink to monitor output"
        return 1
    fi

    record_error_log="$(mktemp)"
    record_fifo_dir="$(mktemp -d)"
    record_fifo="$record_fifo_dir/pcm"
    if ! mkfifo "$record_fifo" 2>/dev/null; then
        msg "Could not create capture pipe under $record_fifo_dir"
        stop_current_recording
        return 1
    fi

    # Start the encoder first (it blocks on the pipe until parec writes),
    # then start capture. Keeping parec and the encoder as separately tracked
    # processes lets us stop capture first on shutdown so the encoder can
    # flush and finalize instead of being killed mid-stream.
    case "$record_format" in
        aac)
            fdkaac -R -S -p "$aac_profile" --bitrate "${bitrate}k" --moov-before-mdat --afterburner 1 \
                --title "$i_title" --artist "$i_artist" --album "$i_album" --album-artist "$i_albumartist" \
                --track "$i_tracknumber" --disk "$i_discnumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        ogg)
            oggenc -b "$bitrate" --raw \
                --title "$i_title" --artist "$i_artist" --album "$i_album" --tracknum "$i_tracknumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        *)
            msg "Invalid record_format '$record_format'"
            stop_current_recording
            return 1
            ;;
    esac

    # Low capture latency keeps less audio stranded in the server buffer, so
    # both the start and the drained tail track the real playback closely.
    parec -d "$nulloutput_name.monitor" --latency-msec=30 > "$record_fifo" 2>>"$record_error_log" &
    parec_pid=$!

    sleep 0.2
    if ! kill -0 "$parec_pid" 2>/dev/null || ! kill -0 "$encoder_pid" 2>/dev/null; then
        local err=""
        if [[ -s "$record_error_log" ]]; then
            err="$(tr '\n' ' ' < "$record_error_log")"
        fi
        kill "$parec_pid" "$encoder_pid" 2>/dev/null || true
        stop_current_recording
        [[ -n "$outputfile" ]] && rm -f "$outputfile"
        if [[ -n "$err" ]]; then
            msg "Recorder failed to start: $err"
        else
            msg "Recorder failed to start. Check codec dependencies and format settings."
        fi
        return 1
    fi

    tui_set "state" "recording"
    tui_set "output" "$outputfile"
    tui_set "message" "Recording '$i_title' by '$i_artist'"
    return 0
}

maybe_start_recording () {
    local signature

    if [[ "$playbackstatus" != "Playing" ]]; then
        return
    fi
    if [[ -z "$title" || -z "$artist" ]]; then
        return
    fi

    signature="${trackid:-$artist|$album|$title}"

    if [[ "$signature" == "$active_recording_signature" ]]; then
        return
    fi

    if start_recording "$artist" "$album" "$title" "$albumartist" "$tracknumber" "$discnumber"; then
        active_recording_signature="$signature"
    fi
}

process_dbus_line () {
    local dbus_read="$1"

    case "$dbus_read" in
        'playbackstatus -> '*)
            playbackstatus="${dbus_read#playbackstatus -> }"
            if [[ "$playbackstatus" == "Playing" ]]; then
                started_playing=true
                maybe_start_recording
            elif [[ "$started_playing" == "true" ]]; then
                # Any non-Playing state after playback began ends the session:
                # no half tracks, and this is where Spotify lands when a
                # playlist finishes. A pause during setup (before the first
                # Playing) is ignored so it does not abort prematurely.
                stop_current_recording "drain"
                active_recording_signature=""
                wait_for_any_key_then_exit "Playback is '$playbackstatus'. Session finished."
            fi
            ;;
        'trackid -> '*)
            trackid="${dbus_read#trackid -> }"
            if [[ "$trackid" != "$last_trackid" ]]; then
                last_trackid="$trackid"
                active_recording_signature=""
                title=""
                artist=""
                album=""
                albumartist=""
                tracknumber=""
                discnumber=""
                stop_current_recording
                tui_set "state" "monitoring"
                tui_set "message" "Detected track change. Waiting for metadata..."
            fi
            maybe_start_recording
            ;;
        'title -> '*)
            title="${dbus_read#title -> }"
            tui_set "track" "$title"
            maybe_start_recording
            ;;
        'artist -> '*)
            artist="${dbus_read#artist -> }"
            tui_set "artist" "$artist"
            maybe_start_recording
            ;;
        'album -> '*)
            album="${dbus_read#album -> }"
            tui_set "album" "$album"
            maybe_start_recording
            ;;
        'albumartist -> '*)
            albumartist="${dbus_read#albumartist -> }"
            ;;
        'tracknumber -> '*)
            tracknumber="${dbus_read#tracknumber -> }"
            ;;
        'discnumber -> '*)
            discnumber="${dbus_read#discnumber -> }"
            ;;
    esac
}

handle_keypress () {
    local key="$1"

    if [[ "$exit_on_any_key" == "true" ]]; then
        should_exit=1
        return
    fi

    case "$key" in
        q|Q)
            should_exit=1
            ;;
        c|C)
            open_config_menu
            ;;
        r|R)
            reload_config
            ;;
    esac
}

remove_null_sink () {
    local module_id

    if [[ "$created_null_sink" == "true" ]] && [[ -n "$nullsink_module_id" ]]; then
        pactl unload-module "$nullsink_module_id" 2>/dev/null || true
    fi

    # Defensively unload any null sink still matching our name so the virtual
    # device never stays active after the session ends (including leftovers
    # from a previous crashed run).
    while IFS= read -r module_id; do
        [[ -n "$module_id" ]] || continue
        pactl unload-module "$module_id" 2>/dev/null || true
    done < <(pactl list short modules 2>/dev/null \
        | grep 'module-null-sink' \
        | grep "sink_name=$nulloutput_name" \
        | cut -f1)

    created_null_sink=false
    nullsink_module_id=""
}

cleanup () {
    # "drain" so a manual quit mid-track still finalizes the current file.
    # After an automatic session end the pids are already cleared, so this
    # is a cheap no-op.
    stop_current_recording "drain"
    if [[ -n "$dbus_monitor_pid" ]] && kill -0 "$dbus_monitor_pid" 2>/dev/null; then
        kill "$dbus_monitor_pid" 2>/dev/null || true
    fi
    remove_null_sink
    tui_leave_screen
    printf '\033[0m\n'
    if [[ -n "$exit_note" ]]; then
        printf '%s\n' "$exit_note" >&2
    fi
}

get_options () {
    local usage="loopcatcher v${SCRIPT_VERSION}

Usage: ${0##*/} [options]

Behavior:
  - If output-directory is omitted, first run uses XDG Music folder and saves it to config.
  - Session name is required every run (interactive prompt if not provided with --session).
  - Output goes to: output-directory/session-name
  - Session auto-finishes when playback becomes pause/stop.

Recommended playback flow:
  1) Open your player and play any track once (creates sink)
  2) Pause playback
  3) Switch to the first track you want to record
  4) Start playback (metadata refresh triggers recording)

Options:
  --debug                   Enable debug
  --output <dir>            Output directory
      --session <name>      Session name override
  --format <format>         Record format: aac or ogg
  --aac-profile <id>        AAC profile (aac only)
  --bitrate <kbps>          Bitrate target
  --scheme <scheme>         Filename scheme: normal, strict, strict-lc-nodir
  --config <path>           Override config file path
  --no-intro                Skip startup intro screen
  --help                    Show help
  --version                 Show version
"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)
                debug=true
                shift
                ;;
            --help)
                show_help=true
                shift
                ;;
            --version)
                show_version=true
                shift
                ;;
            --output)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                output_directory="$2"
                shift 2
                ;;
            --output=*)
                output_directory="${1#*=}"
                shift
                ;;
            --no-intro)
                no_intro=true
                shift
                ;;
            --session)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                session_name="$2"
                shift 2
                ;;
            --session=*)
                session_name="${1#*=}"
                shift
                ;;
            --format)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                record_format="$2"
                case "$record_format" in
                    aac|ogg) ;;
                    *) printf 'Invalid --format value: %s\n' "$record_format"; exit 1 ;;
                esac
                shift 2
                ;;
            --format=*)
                record_format="${1#*=}"
                case "$record_format" in
                    aac|ogg) ;;
                    *) printf 'Invalid --format value: %s\n' "$record_format"; exit 1 ;;
                esac
                shift
                ;;
            --aac-profile)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                aac_profile="$2"
                shift 2
                ;;
            --aac-profile=*)
                aac_profile="${1#*=}"
                shift
                ;;
            --bitrate)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                bitrate="$2"
                shift 2
                ;;
            --bitrate=*)
                bitrate="${1#*=}"
                shift
                ;;
            --scheme)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                filename_scheme="$2"
                case "$filename_scheme" in
                    normal|strict|strict-lc-nodir) ;;
                    *) printf 'Invalid --scheme value: %s\n' "$filename_scheme"; exit 1 ;;
                esac
                shift 2
                ;;
            --scheme=*)
                filename_scheme="${1#*=}"
                case "$filename_scheme" in
                    normal|strict|strict-lc-nodir) ;;
                    *) printf 'Invalid --scheme value: %s\n' "$filename_scheme"; exit 1 ;;
                esac
                shift
                ;;
            --config)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                config_path="$2"
                config_dir="$(dirname "$config_path")"
                shift 2
                ;;
            --config=*)
                config_path="${1#*=}"
                config_dir="$(dirname "$config_path")"
                shift
                ;;
            --)
                shift
                ;;
            -*)
                printf '%s\n' "$usage"
                exit 1
                ;;
            *)
                printf 'Unknown argument: %s\n\n' "$1"
                printf '%s\n' "$usage"
                exit 1
                ;;
        esac
    done

    if [[ "$show_help" == "true" ]]; then
        printf '%s\n' "$usage"
        exit 0
    fi
    if [[ "$show_version" == "true" ]]; then
        printf 'loopcatcher version %s\n' "$SCRIPT_VERSION"
        exit 0
    fi
}

main () {
    get_options "$@"
    check_dependencies
    ensure_config_dir
    load_config
    get_options "$@"
    validate_settings
    check_encoder_dependency
    tui_measure_cols
    if [[ "$no_intro" != "true" ]]; then
        show_startup_info
    fi

    initialize_output_directory
    prompt_session_name
    check_audio_server

    get_target_sink_index
    case $? in
        0)
            ;;
        2)
            show_blocking_notice_and_exit "No active sink-input found. Open your player, start playback, then run again."
            ;;
        3)
            show_blocking_notice_and_exit "Sink-input exists but no app matched sink_app_name='$sink_app_name'. Open config menu (c) to adjust it."
            ;;
        *)
            show_blocking_notice_and_exit "Could not detect target sink."
            ;;
    esac

    trap cleanup EXIT
    trap 'should_exit=1' INT TERM

    create_null_audio_output
    move_target_output

    tui_enter_screen
    trap 'tui_resize' WINCH

    tui_set "state" "monitoring"
    tui_set "message" "Monitoring MPRIS metadata. If playback shows Unknown, start playback or switch to another track to emit metadata."

    coproc DBUS_MONITOR { get_dbusmessages "path=/org/mpris/MediaPlayer2,member=PropertiesChanged"; }
    dbus_monitor_pid=$!

    local got_line idle_timeout
    while [[ $should_exit -eq 0 ]]; do
        got_line=0
        # read() returns the instant a line is ready regardless of the
        # timeout, so a whole metadata burst is still consumed back-to-back
        # (no keypad stall between lines) and recording starts fast. The
        # timeout only paces the idle wait: tight while recording so the
        # spinner animates, relaxed otherwise to stay light on the CPU.
        idle_timeout=0.2
        [[ "$tui_state" == "recording" ]] && idle_timeout=0.05
        if [[ "$exit_on_any_key" != "true" ]]; then
            if IFS= read -r -t "$idle_timeout" -u "${DBUS_MONITOR[0]}" dbus_read; then
                process_dbus_line "$dbus_read"
                got_line=1
            fi
        fi

        if [[ $got_line -eq 0 ]]; then
            if IFS= read -rsn1 -t 0.05 key; then
                handle_keypress "$key"
            fi
            if [[ "$tui_state" == "recording" ]]; then
                tui_frame=$((tui_frame + 1))
                tui_render
            fi
        fi

        if [[ "$exit_on_any_key" != "true" ]] && ! kill -0 "$dbus_monitor_pid" 2>/dev/null; then
            exit_note="loopcatcher: dbus-monitor ended, session stopped."
            break
        fi
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
