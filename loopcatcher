###############################################################################
# Session Name screen
###############################################################################

session_name_screen () {
    local suggested prefill="" err="" value candidate

    # CLI --session fast path: validate, never prompt.
    if [[ -n "${session_name:-}" ]]; then
        if ! err="$(validate_session_name "$session_name")"; then
            printf 'FATAL: %s (from --session).\n' "$err" >&2
            exit 1
        fi
        candidate="$output_directory/$session_name"
        if dir_not_empty "$candidate"; then
            printf 'FATAL: session folder from --session exists and is not empty: %s\n' "$candidate" >&2
            exit 1
        fi
        session_output_directory="$candidate"
        mkdir -p -- "$session_output_directory" \
            || { printf 'FATAL: cannot create session folder: %s\n' "$candidate" >&2; exit 1; }
        return
    fi

    suggested="$(default_session_name)"

    while true; do
        render_page "Session Name" \
            "$(ui_box \
                "This is the session name. It is used to generate the destination folder for what will be recorded, so existing files are not accidentally overwritten." \
                "" \
                "$(gum style --bold -- 'Enter a UNIQUE session name that has not been used before.')")"
        [[ -n "$err" ]] && printf '%s\n' "$(ui_notify "$err")"
        ui_gap

        if ! value="$(gum input --header "Session name (Enter for the suggested name, Esc to cancel)" \
                --prompt="$UI_CURSOR" --placeholder "$suggested" --value "$prefill")"; then
            _cancel_and_exit
        fi
        [[ -z "$value" ]] && value="$suggested"

        if ! err="$(validate_session_name "$value")"; then
            prefill="$value"; continue
        fi
        candidate="$output_directory/$value"
        if dir_not_empty "$candidate"; then
            err="Session folder exists and is not empty: $candidate"
            prefill="$value"; continue
        fi
        break
    done

    session_name="$value"
    session_output_directory="$candidate"
    mkdir -p -- "$session_output_directory" \
        || { printf 'FATAL: cannot create session folder: %s\n' "$candidate" >&2; exit 1; }
}

