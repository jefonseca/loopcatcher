                ui_screen "first-run setup"
                player_mpris_bus="$(gum input --header "player_mpris_bus" --value "$player_mpris_bus")" || _onboarding_abort
                ui_screen "first-run setup"
                player_sink_match="$(gum input --header "player_sink_match (space-separated globs)" --value "$player_sink_match")" || _onboarding_abort
                ;;
        esac

        ui_screen "first-run setup"
        record_format="$(gum choose --header "Codec" --selected "$record_format" -- aac ogg)" || _onboarding_abort
        ui_screen "first-run setup"
