#!/bin/bash
###############################################################################
# loopcatcher - record app/system loopback audio to AAC or OGG files.
#
# Flow: onboarding (first run only) -> session name -> sink detection / wizard
#       -> live status view (metadata + recording). Press "m" in the status view
#       to open the gum menu (Resume / Config / Reload / About / License / Quit).
#       The session ends automatically when playback stops.
###############################################################################

set -u
set -o pipefail

if [[ $EUID -eq 0 ]]; then
    echo "This script must not be run as root"
    exit 1
fi

###############################################################################
# Constants
###############################################################################

# gum styling rules for the whole UI: no explicit colours (terminal defaults),
# fixed --width 100, --border rounded (never double).
UI_WIDTH=100

# Keep gum styling (bold, borders) when its stdout is a pipe - the nested
# $(gum style ...) fragments composed inside status_render need this.
export CLICOLOR_FORCE=1

# Built-in "spotify" player profile.
readonly SPOTIFY_MPRIS_BUS="org.mpris.MediaPlayer2.spotify"
readonly SPOTIFY_SINK_MATCH="spotify spotify* com.spotify.client com.spotify.client* com.spotify.Client*"

###############################################################################
# Global state
###############################################################################

# --- persisted to the config file ---
debug=false
player_profile="spotify"
sink_app_name="spotify"
player_mpris_bus="$SPOTIFY_MPRIS_BUS"
player_sink_match="$SPOTIFY_SINK_MATCH"
nulloutput_name="loopcatcher"
aac_profile="29"
bitrate="48"
record_format="aac"
filename_scheme="normal"
output_directory=""
# Extra capture time (seconds) kept running after the player reports pause/stop
# so the audio tail still in the sink -> parec -> pipe -> encoder chain is
# written instead of cut. Trade-off: up to this much near-silence at the end of
# the last track. 0 disables it.
tail_drain_seconds="0.35"

# --- CLI / lifecycle ---
show_help=false
show_version=false
no_intro=false
should_exit=0
exit_note=""

# --- live status view ---
status_active=false
status_dirty=0            # main_loop repaints once per tick only when this is set
_status_last_frame=""     # last painted frame; identical repaints are skipped
STATUS_TITLE=""           # precomputed once (see status_chrome_init)
STATUS_INFO=""            # precomputed once (session/sink/config/output box)
tui_state="starting"
tui_last_message=""
tui_track="-"
tui_artist="-"
tui_album="-"
tui_output="-"

# --- session ---
session_name=""
session_output_directory=""

# --- sink routing ---
source_sink_index=""

# --- recording engine ---
parec_pid=""
encoder_pid=""
record_fifo_dir=""
record_error_log=""
stopping_recording=false

# --- MPRIS monitor ---
dbus_monitor_pid=""
playbackstatus="Unknown"
started_playing=false
active_recording_signature=""
trackid=""
last_trackid=""
title=""
artist=""
album=""
albumartist=""
tracknumber=""
discnumber=""

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$XDG_CONFIG_HOME/loopcatcher"
config_path="$config_dir/config"

get_script_version () {
    local script_dir version_file file_version
    script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    for version_file in "$script_dir/VERSION" "/usr/share/loopcatcher/VERSION"; do
        if [[ -r "$version_file" ]]; then
            IFS= read -r file_version < "$version_file"
            printf '%s\n' "$file_version"
            return
        fi
    done
    printf '%s\n' "0.0-dev"
}

SCRIPT_VERSION="$(get_script_version)"

###############################################################################
# Dependency checks
###############################################################################

check_dependencies () {
    local req
    local -a requirements=(
        gum tr cut awk grep
        dbus-monitor dbus-send
        pactl parec
        tput mktemp mkfifo
    )
    for req in "${requirements[@]}"; do
        command -v "$req" >/dev/null 2>&1 && continue
        printf 'FATAL: required command "%s" was not found in PATH.\n' "$req" >&2
        [[ "$req" == "gum" ]] && printf 'Install it with: sudo apt install gum   (Debian 13+; older releases: repo.charm.sh)\n' >&2
        exit 1
    done
}

check_encoder_dependency () {
    local tool
    case "$record_format" in
        aac) tool="fdkaac" ;;
        ogg) tool="oggenc" ;;
        *) return ;;
    esac
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'FATAL: "%s" is required for record_format=%s but was not found\n' "$tool" "$record_format" >&2
        exit 1
    fi
}

###############################################################################
# gum UI helpers
###############################################################################

require_tty () {
    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'FATAL: %s requires an interactive terminal.\n' "${1:-this step}" >&2
        exit 4
    fi
}

ui_clear () {
    printf '\033[H\033[2J'
}

# Standard panel: fixed width, rounded border, terminal-default colours.
ui_box () {
    gum style --width "$UI_WIDTH" --border rounded --padding "1 4" -- "$@"
}

# Centre-aligned, bold title panel.
ui_title () {
    gum style --width "$UI_WIDTH" --border rounded --align center --bold --padding "1 1" -- "$@"
}

# Every gum screen starts here: clear, draw the page title, add a two-line gap
# before the following element (choose / box / input).
ui_screen () {
    local sub="${1:-}"
    [[ $# -ge 1 ]] && shift
    ui_clear
    ui_title "loopcatcher  -  $sub" "$@"
    printf '\n\n'
}

# Shorten a value for the status view: keep the tail, prefix with an ellipsis.
_clip () {
    local s="$1" max="${2:-86}"
    if (( ${#s} > max )); then
        s="…${s: -$((max - 1))}"
    fi
    printf '%s' "$s"
}

# "Label" (bold, padded to a column) immediately followed by its value.
# Raw SGR (not "gum style") so it costs no subprocess - status_render runs this
# several times per repaint.
_kv () {
    local label
    printf -v label '%-17s' "$1"
    printf '\033[1m%s\033[0m%s' "$label" "$2"
}

# Floating "tooltip" style used for the wait / announce screens.
ui_tooltip () {
    gum style --border rounded --width 80 --margin "4 10" --padding "4 4" -- "$@"
}

# In-place repaint for the live status view: home, write the already-composed
# frame, erase whatever the previous (taller) frame left below. No full \033[2J,
# so there is no blank flash - the old frame stays until the new bytes land.
# Every status line is full-width, so nothing is left to the right.
paint_frame () {
    printf '\033[H%s\033[J' "$1"
}

# One-shot screens (wizard / tooltip): wipe the whole screen and draw the frame
# in a single write() so the clear and the draw reach the terminal together.
paint_screen () {
    printf '\033[2J\033[H%s' "$1"
}

# Full screen: page title, then a centred tooltip box. Composed first, then
# painted in one write.
ui_tooltip_screen () {
    local sub="${1:-}"
    [[ $# -ge 1 ]] && shift
    paint_screen "$(printf '%s\n%s' \
        "$(ui_title "loopcatcher  -  $sub")" \
        "$(ui_tooltip "$@")")"
}

# One Recording Wizard step: the title bar, then a tooltip box holding a bold,
# centred "Step N" heading followed by left-aligned instruction lines and the
# cancel hint. $1 = heading; the remaining args = instruction lines.
wizard_step_screen () {
    local heading="$1"; shift
    paint_screen "$(printf '%s\n%s' \
        "$(ui_title "loopcatcher  -  Recording Wizard")" \
        "$(ui_tooltip "$(gum join --vertical \
            "$(gum style --bold --align center --width 70 -- "$heading")" \
            "$(gum style --width 70 -- "" "$@" "" '(press q to cancel)')")")")"
}

###############################################################################
# Live status view (event-driven; no animation, redrawn only on real changes)
###############################################################################

# tui_output made relative to the session folder (Artist/Album/File).
status_output_relpath () {
    local f="${tui_output:--}"
    if [[ "$f" == "-" || -z "$f" ]]; then
        printf -- '-'
    elif [[ -n "$session_output_directory" && "$f" == "$session_output_directory/"* ]]; then
        printf '%s' "${f#"$session_output_directory"/}"
    else
        printf '%s' "$f"
    fi
}

# The title bar and the session-info box never change during a session, so build
# them once. Call again after the config menu (output_directory may have moved).
status_chrome_init () {
    STATUS_TITLE="$(ui_title "loopcatcher  -  v$SCRIPT_VERSION")"
    STATUS_INFO="$(gum style --width "$UI_WIDTH" --border rounded --padding "1 2" -- \
        "$(_kv 'Session Name:'  "$(_clip "${session_name:--}" 74)")" \
        "$(_kv 'Audio Sink:'    "${source_sink_index:--}")" \
        "$(_kv 'Config File:'   "$(_clip "$config_path" 74)")" \
        "$(_kv 'Output Folder:' "$(_clip "${output_directory:--}" 74)")")"
}

status_render () {
    [[ "$status_active" == "true" && -t 1 ]] || return

    local frame

    if [[ "$started_playing" != "true" ]]; then
        # Before the first Playing: the final Recording Wizard step. Composed
        # here (not via wizard_step_screen) so the identical-frame check applies.
        frame="$(printf '%s\n%s' \
            "$(ui_title "loopcatcher  -  Recording Wizard")" \
            "$(ui_tooltip "$(gum join --vertical \
                "$(gum style --bold --align center --width 70 -- 'Step 3: Start recording')" \
                "$(gum style --width 70 -- '' \
                    '1) Play the first track of your playlist or album to start the recording automatically' \
                    '' '(press q to cancel)')")")")"
    else
        local tab meta status
        tab="$(printf 'Field\tValue\nArtist\t%s\nAlbum\t%s\nTrack\t%s\nOutput File\t%s\n' \
            "$(_clip "${tui_artist:--}" 78)" \
            "$(_clip "${tui_album:--}" 78)" \
            "$(_clip "${tui_track:--}" 78)" \
            "$(_clip "$(status_output_relpath)" 78)" \
            | gum table --print --separator "$(printf '\t')" --border rounded --widths 14,80)"
        meta="$(gum style --width "$UI_WIDTH" --border rounded --padding "1 2" -- "$tab")"
        status="$(gum style --width "$UI_WIDTH" --border rounded --padding "1 2" -- \
            "$(_kv 'Catcher Status:'  "$tui_state")" \
            "$(_kv 'Playback Status:' "$playbackstatus")" \
            "" \
            "$(printf '\033[1mPress "m" key to open the menu\033[0m')")"
        printf -v frame '%s\n%s\n%s\n%s' "$STATUS_TITLE" "$STATUS_INFO" "$meta" "$status"
    fi

    # Repainting the same bytes in place is invisible; skip the write entirely.
    [[ "$frame" == "$_status_last_frame" ]] && return
    _status_last_frame="$frame"
    paint_frame "$frame"
}

screen_enter () {
    [[ "$status_active" == "true" && -t 1 ]] || return
    # Switch to the alternate screen, hide the cursor, start from a clean buffer
    # so the first in-place paint_frame has nothing stale under it.
    printf '\033[?1049h\033[?25l\033[2J\033[H'
}

screen_leave () {
    [[ "$status_active" == "true" && -t 1 ]] || return
    printf '\033[?25h\033[?1049l'
}

###############################################################################
# UI state mutators
###############################################################################

msg () {
    if [[ "${2:-}" == "debug" ]]; then
        if [[ "$debug" == "true" || "$debug" == "yes" ]]; then
            printf 'DEBUG: %s\n' "$1" >&2
        fi
        return
    fi
    tui_last_message="$1"
    status_dirty=1
    return 0
}

# Setters only flag the view dirty; main_loop coalesces a burst of these into a
# single repaint per tick (a metadata burst is 5+ setters).
tui_set () {
    case "$1" in
        state)   tui_state="$2" ;;
        track)   tui_track="$2" ;;
        artist)  tui_artist="$2" ;;
        album)   tui_album="$2" ;;
        output)  tui_output="$2" ;;
        message) tui_last_message="$2" ;;
    esac
    status_dirty=1
    return 0
}

finish_session_and_exit () {
    tui_state="session-ended"
    tui_last_message="$1"
    if [[ "$status_active" == "true" && -t 1 ]]; then
        ui_tooltip_screen "v$SCRIPT_VERSION" \
            "$1" \
            "" \
            "Your recordings are in:" \
            "${session_output_directory:-$output_directory}" \
            "" \
            "Press any key to exit."
        read -rsn1
    fi
    should_exit=1
    return 0
}

###############################################################################
# Config file
###############################################################################

ensure_config_dir () {
    if ! mkdir -p -- "$config_dir"; then
        printf 'FATAL: cannot create config directory: %s\n' "$config_dir" >&2
        exit 1
    fi
}

load_config () {
    if [[ -r "$config_path" ]]; then
        # shellcheck disable=SC1090
        source "$config_path"
    fi

    # Legacy key aliases (never written back).
    [[ -n "${recordformat:-}" ]]   && record_format="$recordformat"
    [[ -n "${filenamescheme:-}" ]] && filename_scheme="$filenamescheme"

    case "${player_profile:-}" in
        custom)
            # Trust the file; fill any missing detection field with Spotify's.
            [[ -n "${sink_app_name:-}" ]]     || sink_app_name="spotify"
            [[ -n "${player_mpris_bus:-}" ]]  || player_mpris_bus="$SPOTIFY_MPRIS_BUS"
            [[ -n "${player_sink_match:-}" ]] || player_sink_match="$SPOTIFY_SINK_MATCH"
            ;;
        *)
            # spotify / empty / unknown: (re)apply the Spotify profile.
            player_profile_apply spotify
            ;;
    esac
}

save_config () {
    local tmp
    tmp="$(mktemp -- "$config_path.XXXXXX")" || {
        printf 'WARN: could not write config (mktemp failed in %s)\n' "$config_dir" >&2
        return 1
    }
    cat > "$tmp" <<EOF
# loopcatcher config - edited at runtime via the status-view menu (press "m").
debug="$debug"
player_profile="$player_profile"
sink_app_name="$sink_app_name"
player_mpris_bus="$player_mpris_bus"
player_sink_match="$player_sink_match"
nulloutput_name="$nulloutput_name"
aac_profile="$aac_profile"
bitrate="$bitrate"
record_format="$record_format"
filename_scheme="$filename_scheme"
output_directory="$output_directory"
tail_drain_seconds="$tail_drain_seconds"
EOF
    # Atomic replace: a crash mid-write never leaves a truncated config.
    mv -f -- "$tmp" "$config_path" || { rm -f -- "$tmp"; return 1; }
}

reload_config () {
    load_config
    if validate_settings_soft; then
        tui_set "message" "Config reloaded from $config_path"
    else
        tui_set "message" "Config reloaded with warnings (check values)"
    fi
}

# Prints the first problem it finds and returns 1; returns 0 when all valid.
# validate_settings is the hard (exit 1) startup wrapper; validate_settings_soft
# is used from the live config menu / reload so a bad value cannot kill a run.
_validate_settings () {
    case "$record_format" in
        aac|ogg) ;;
        *) printf 'Invalid record_format: %s (allowed: aac, ogg)\n' "$record_format"; return 1 ;;
    esac
    case "$filename_scheme" in
        normal|strict|strict-lc-nodir) ;;
        *) printf 'Invalid filename_scheme: %s (allowed: normal, strict, strict-lc-nodir)\n' "$filename_scheme"; return 1 ;;
    esac
    case "$player_profile" in
        spotify|custom) ;;
        *) printf 'Invalid player_profile: %s (allowed: spotify, custom)\n' "$player_profile"; return 1 ;;
    esac
    if [[ ! "$player_mpris_bus" =~ ^org\.mpris\.MediaPlayer2\.[A-Za-z0-9._-]+$ ]]; then
        printf 'Invalid player_mpris_bus: %s\n' "$player_mpris_bus"; return 1
    fi
    if [[ -z "$player_sink_match" ]]; then
        printf 'player_sink_match must not be empty\n'; return 1
    fi
    if [[ ! "$bitrate" =~ ^[0-9]+$ ]] || [[ "$bitrate" -le 0 ]]; then
        printf 'Invalid bitrate: %s (must be a positive integer)\n' "$bitrate"; return 1
    fi
    if [[ ! "$aac_profile" =~ ^[0-9]+$ ]] || [[ "$aac_profile" -le 0 ]]; then
        printf 'Invalid aac_profile: %s (must be a positive integer)\n' "$aac_profile"; return 1
    fi
    if [[ ! "$tail_drain_seconds" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf 'Invalid tail_drain_seconds: %s (must be a non-negative number, e.g. 0.35)\n' "$tail_drain_seconds"; return 1
    fi
    case "$debug" in
        true|false|yes|no) ;;
        *) printf 'Invalid debug: %s (allowed: true, false, yes, no)\n' "$debug"; return 1 ;;
    esac
    return 0
}

validate_settings () {
    _validate_settings || exit 1
}

validate_settings_soft () {
    _validate_settings
}

###############################################################################
# Player profiles
###############################################################################

player_profile_label () {
    case "${1:-}" in
        spotify) printf 'Spotify' ;;
        custom)  printf 'Custom Player' ;;
        *)       printf '%s' "${1:-your player}" ;;
    esac
}

# spotify -> overwrite the three detection fields with Spotify's values.
# custom  -> just mark the profile; the caller edits the fields.
player_profile_apply () {
    case "${1:-}" in
        spotify)
            player_profile="spotify"
            sink_app_name="spotify"
            player_mpris_bus="$SPOTIFY_MPRIS_BUS"
            player_sink_match="$SPOTIFY_SINK_MATCH"
            ;;
        custom)
            player_profile="custom"
            ;;
        *)
            return 1
            ;;
    esac
}

# One-shot PlaybackStatus query (used by the wizard before the coproc exists).
player_playback_status () {
    dbus-send --print-reply --dest="$player_mpris_bus" /org/mpris/MediaPlayer2 \
        org.freedesktop.DBus.Properties.Get \
        string:org.mpris.MediaPlayer2.Player string:PlaybackStatus 2>/dev/null \
      | awk -F'"' '/string "(Playing|Paused|Stopped)"/{print $2; exit}'
}

###############################################################################
# Output directory / session name
###############################################################################

pick_directory () {
    local start="${1:-$HOME}"
    [[ -d "$start" ]] || start="$HOME"
    gum file --directory --height=10 "$start"
}

# Best guess at the user's Music folder. Never prints just $HOME (xdg-user-dir
# returns that when MUSIC is unconfigured) - falls through to $HOME/Music.
default_music_dir () {
    local dir=""
    if command -v xdg-user-dir >/dev/null 2>&1; then
        dir="$(xdg-user-dir MUSIC 2>/dev/null || true)"
        [[ -n "$dir" && "$dir" != "$HOME" ]] && { printf '%s\n' "$dir"; return; }
    fi
    if [[ -f "$HOME/.config/user-dirs.dirs" ]]; then
        dir="$(grep '^XDG_MUSIC_DIR=' "$HOME/.config/user-dirs.dirs" | cut -d'=' -f2- | tr -d '"')"
        dir="${dir//\$HOME/$HOME}"
        [[ -n "$dir" && "$dir" != "$HOME" ]] && { printf '%s\n' "$dir"; return; }
    fi
    printf '%s\n' "$HOME/Music"
}

initialize_output_directory () {
    local defaulted=0
    [[ -n "$output_directory" ]] || { output_directory="$(default_music_dir)"; defaulted=1; }

    if [[ -z "$output_directory" ]]; then
        printf 'FATAL: could not determine an output directory (HOME is unset).\n' >&2
        exit 1
    fi
    if ! mkdir -p -- "$output_directory"; then
        printf 'FATAL: cannot create output directory: %s\n' "$output_directory" >&2
        exit 1
    fi

    # Persist the auto-picked default so it stays put on the next run.
    [[ $defaulted -eq 1 ]] && save_config
    return 0
}

default_session_name () {
    printf '%s-loopcatcher\n' "$(date +%Y%m%d-%H%M%S)"
}

# Reject a name that cannot be one safe path component. Prints the reason.
validate_session_name () {
    case "${1:-}" in
        "")       printf 'Session name cannot be empty' ;;
        . | ..)   printf "Session name cannot be '.' or '..'" ;;
        */*)      printf "Session name cannot contain '/'" ;;
        *)        return 0 ;;
    esac
    return 1
}

# 0 when directory $1 exists and holds at least one entry (dotfiles included).
dir_not_empty () {
    local d="$1" e
    [[ -d "$d" ]] || return 1
    for e in "$d"/* "$d"/.[!.]* "$d"/..?*; do
        [[ -e "$e" || -L "$e" ]] && return 0
    done
    return 1
}

# Resolve session_name + session_output_directory, then create the folder.
session_name_step () {
    local suggested prefill="" err="" value candidate

    # CLI --session fast path: validate, never prompt.
    if [[ -n "${session_name:-}" ]]; then
        if ! err="$(validate_session_name "$session_name")"; then
            printf 'FATAL: %s (from --session).\n' "$err" >&2
            exit 1
        fi
        candidate="$output_directory/$session_name"
        if dir_not_empty "$candidate"; then
            printf 'FATAL: session folder from --session exists and is not empty: %s\n' "$candidate" >&2
            exit 1
        fi
        session_output_directory="$candidate"
        mkdir -p -- "$session_output_directory" \
            || { printf 'FATAL: cannot create session folder: %s\n' "$candidate" >&2; exit 1; }
        return
    fi

    require_tty "session setup"
    suggested="$(default_session_name)"

    while true; do
        ui_screen "session"
        ui_box \
            "This session:" \
            "" \
            "  - captures the app audio through a Linux loopback monitor sink" \
            "  - saves files under  output_directory/session_name" \
            "  - stops automatically when playback pauses or stops" \
            "" \
            "Recommended flow:" \
            "  1  Play a track once to create the sink" \
            "  2  Pause and select the first track to record" \
            "  3  Leave loopcatcher open while still paused" \
            "  4  Press Play - recording starts on the metadata refresh" \
            "" \
            "Disable Autoplay / Crossfade / Gapless in your player so the session ends cleanly."
        [[ -n "$err" ]] && ui_box "$err"

        # Placeholder = the suggested timestamp name (used when the field is left
        # empty). prefill = the last rejected entry, so a typo can be corrected
        # instead of retyped.
        if ! value="$(gum input --header "Session name  (Enter for the suggested name, Esc to cancel)" \
                --placeholder "$suggested" --value "$prefill")"; then
            printf 'Cancelled.\n' >&2
            exit 0
        fi
        [[ -z "$value" ]] && value="$suggested"

        if ! err="$(validate_session_name "$value")"; then
            prefill="$value"; continue
        fi
        candidate="$output_directory/$value"
        if dir_not_empty "$candidate"; then
            err="Session folder exists and is not empty: $candidate"
            prefill="$value"; continue
        fi
        break
    done

    session_name="$value"
    session_output_directory="$candidate"
    mkdir -p -- "$session_output_directory" \
        || { printf 'FATAL: cannot create session folder: %s\n' "$candidate" >&2; exit 1; }
}

###############################################################################
# Config menu (grouped by context)
###############################################################################

# Edit one variable named by $1 with a gum choose ($3.. = options) or gum input.
_cfg_edit_choice () {
    local var="$1" header="$2"
    shift 2
    local new
    ui_screen "configuration"
    new="$(gum choose --header "$header" --selected "${!var}" -- "$@")" && printf -v "$var" '%s' "$new"
}

_cfg_edit_input () {
    local var="$1" header="$2"
    local new
    ui_screen "configuration"
    new="$(gum input --header "$header" --value "${!var}")" && printf -v "$var" '%s' "$new"
}

config_menu_codecs () {
    while true; do
        ui_screen "configuration"
        case "$(gum choose --header "Codecs" -- \
            "Record Format:  $record_format" \
            "AAC Profile:  $aac_profile" \
            "Bitrate:  $bitrate" \
            "< Back")" in
            "Record Format:"*) _cfg_edit_choice record_format "Record format" aac ogg ;;
            "AAC Profile:"*)   _cfg_edit_input  aac_profile "AAC profile (applies to aac only)" ;;
            "Bitrate:"*)       _cfg_edit_input  bitrate "Bitrate (kbps)" ;;
            *)                 return ;;
        esac
    done
}

config_menu_paths () {
    local d
    while true; do
        ui_screen "configuration"
        case "$(gum choose --header "Paths" -- \
            "Output Folder:  $output_directory" \
            "Filename Scheme:  $filename_scheme" \
            "< Back")" in
            "Output Folder:"*)
                d="$(pick_directory "${output_directory:-$HOME}")" \
                    && [[ -n "$d" ]] && { output_directory="$d"; mkdir -p -- "$output_directory"; }
                ;;
            "Filename Scheme:"*)
                _cfg_edit_choice filename_scheme "Filename scheme" normal strict strict-lc-nodir
                ;;
            *) return ;;
        esac
    done
}

config_menu_player () {
    local p
    while true; do
        ui_screen "configuration"
        case "$(gum choose --header "Player" -- \
            "Player Profile:  $player_profile" \
            "Sink App Name:  $sink_app_name" \
            "MPRIS Bus:  $player_mpris_bus" \
            "Sink Match:  $player_sink_match" \
            "Null Sink Name:  $nulloutput_name" \
            "< Back")" in
            "Player Profile:"*)
                ui_screen "configuration"
                p="$(gum choose --header "Player profile" --selected "$player_profile" -- spotify custom)" \
                    && player_profile_apply "$p"
                ;;
            # Editing a detection field means this is no longer the stock Spotify
            # profile - flip to "custom" so the edit is persisted, not reverted.
            "Sink App Name:"*) _cfg_edit_input sink_app_name    "Sink app name"                          && player_profile="custom" ;;
            "MPRIS Bus:"*)     _cfg_edit_input player_mpris_bus "MPRIS bus name"                          && player_profile="custom" ;;
            "Sink Match:"*)    _cfg_edit_input player_sink_match "Sink match (space-separated globs)"      && player_profile="custom" ;;
            "Null Sink Name:"*) _cfg_edit_input nulloutput_name "Null sink name" ;;
            *) return ;;
        esac
    done
}

config_menu_advanced () {
    while true; do
        ui_screen "configuration"
        case "$(gum choose --header "Advanced" -- \
            "Tail Drain Seconds:  $tail_drain_seconds" \
            "Debug:  $debug" \
            "< Back")" in
            "Tail Drain Seconds:"*) _cfg_edit_input tail_drain_seconds "Tail drain seconds (e.g. 0.35)" ;;
            "Debug:"*)              _cfg_edit_choice debug "Debug" false true ;;
            *)                      return ;;
        esac
    done
}

config_menu () {
    require_tty "config menu"
    local verr
    while true; do
        ui_screen "configuration"
        case "$(gum choose --header "Select a group" -- \
            "Codecs" "Paths" "Player" "Advanced" \
            "Save & Exit" "Discard & Exit")" in
            Codecs)   config_menu_codecs ;;
            Paths)    config_menu_paths ;;
            Player)   config_menu_player ;;
            Advanced) config_menu_advanced ;;
            "Save & Exit")
                if verr="$(validate_settings_soft 2>&1)"; then
                    save_config
                    break
                fi
                ui_screen "configuration"
                ui_box "$verr"
                [[ "$(gum choose --header "Invalid values" -- "Keep editing" "Discard & Exit")" == "Discard & Exit" ]] && break
                ;;
