###############################################################################
# Recording Wizard
###############################################################################

wizard_step_screen () {
    local n="$1" spinner="$2" kind="$3" heading="$4"; shift 4
    local spin_title
    case "$kind" in
        sink)    spin_title="Waiting for the audio sink..." ;;
        stopped) spin_title="Waiting for playback to pause..." ;;
        playing) spin_title="Waiting for playback to start..." ;;
        *)       spin_title="Waiting..." ;;
    esac

    render_page "Recording Wizard" \
        "$(ui_box "$(ui_subtitle "Step $n: $heading")" "" "$@")"
    ui_gap

    gum spin --spinner "$spinner" --title "$spin_title" -- \
        "$0" --internal-wait "$kind" --config "$config_path" \
        || _cancel_and_exit
}

recording_wizard () {
    local label
    label="$(player_profile_label "$player_profile")"

    if ! get_target_sink_index; then
        wizard_step_screen 1 points sink "Create the Audio Sink" \
            "1) Open your $label" \
            "2) Play any track that is NOT the first in your playlist or album you want to record"
        get_target_sink_index || true
    fi

    if ! _playback_is_stopped; then
        wizard_step_screen 2 points stopped "Prepare to record" \
            "1) Pause the playback on your $label"
    fi

    # By this point playback is confirmed paused/stopped (step 2 guaranteed it,
    # or it already was). Start listening for MPRIS signals now, before the
    # user presses Play again, so the Playing transition and the first track's
    # metadata - both one-shot signals - are not missed.
    coproc DBUS_MONITOR { get_dbusmessages "path=/org/mpris/MediaPlayer2,member=PropertiesChanged,sender=$player_mpris_bus"; }
    dbus_monitor_pid=$!

    if ! _playback_is_playing; then
        wizard_step_screen 3 points playing "Start recording" \
            "1) Play the first track of your playlist or album to start the recording automatically"
    fi
}

###############################################################################
# Audio server / sink detection / routing
###############################################################################

check_audio_server () {
    if ! pactl info >/dev/null 2>&1; then
        printf 'FATAL: cannot connect to the PulseAudio/PipeWire session daemon.\n' >&2
        printf 'On KDE, ensure pipewire-pulse is running in your user session.\n' >&2
        printf 'Try: systemctl --user status pipewire pipewire-pulse wireplumber\n' >&2
        exit 1
    fi
}

is_target_sink_app () {
    local configured_name="$1" app_name="$2" pat
    local -a pats

    [[ -n "$configured_name" && "$app_name" == "$configured_name" ]] && return 0

    read -r -a pats <<< "$player_sink_match"
    for pat in "${pats[@]}"; do
        # Unquoted RHS on purpose: pat is a glob from the player profile.
        # shellcheck disable=SC2053
        [[ "${app_name,,}" == ${pat,,} ]] && return 0
    done
    return 1
}

# Sets source_sink_index. Returns: 0 matched, 2 no sink-inputs, 3 none matched.
get_target_sink_index () {
    local sink_list sink_index="" sink_app="" line

    sink_list="$(pactl list sink-inputs 2>/dev/null)"
    [[ -z "$sink_list" ]] && return 2

    while IFS= read -r line; do
        if [[ $line == "Sink Input #"* ]]; then
            sink_index="${line#Sink Input #}"
        elif [[ $line == *"application.name = "* ]]; then
            sink_app="$(cut -d '"' -f2 <<< "$line")"
            if is_target_sink_app "$sink_app_name" "$sink_app"; then
                source_sink_index="$sink_index"
                log_debug "matched target sink: $sink_app"
                return 0
            fi
        fi
    done <<< "$sink_list"

    return 3
}

ensure_target_routed () {
    # Fast path: reuse the cached sink-input id (move-sink-input is idempotent).
    if [[ -n "$source_sink_index" ]] \
        && pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        return 0
    fi

    # Slow path: the player likely replaced its sink-input (e.g. track change).
    # Non-fatal so a transient failure does not kill the run.
    get_target_sink_index || return 1
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        log_line "could not move sink-input $source_sink_index to '$nulloutput_name'"
        return 1
    fi
    return 0
}

# Module ids of every loaded module-null-sink whose sink_name is exactly
# $nulloutput_name (an exact token match, so "loopcatcher" != "loopcatcher2").
_null_sink_module_ids () {
    pactl list short modules 2>/dev/null | awk -v want="sink_name=$nulloutput_name" '
        $2 == "module-null-sink" {
            n = split($0, tok, /[ \t]+/)
            for (i = 1; i <= n; i++) if (tok[i] == want) { print $1; break }
        }'
}

create_null_audio_output () {
    # Reuse an existing sink of our name (e.g. leftover from a crashed run);
    # otherwise load a fresh one. cleanup() unloads it either way.
    [[ -n "$(_null_sink_module_ids)" ]] && return 0
    if ! pactl load-module module-null-sink sink_name="$nulloutput_name" >/dev/null; then
        printf 'FATAL: cannot create null sink "%s".\n' "$nulloutput_name" >&2
        exit 1
    fi
}

move_target_output () {
    if ! pactl move-sink-input "$source_sink_index" "$nulloutput_name" 2>/dev/null; then
        printf 'FATAL: cannot move sink-input %s to "%s".\n' "$source_sink_index" "$nulloutput_name" >&2
        exit 1
    fi
}

###############################################################################
# Filename building
###############################################################################

sanitize_str () {
    if [[ "$1" == "strict" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2"
    elif [[ "$1" == "strict-lc" ]]; then
        tr -dc '[:alnum:]\n\r' <<< "$2" | tr '[:upper:]' '[:lower:]'
    fi
}

# "normal" scheme component: keep Unicode letters/marks, strip only path-unsafe
# / FAT/NTFS-reserved chars so recordings to removable drives still work.
sanitize_component () {
    local s="$1"
    s="${s//\//_}"
    s="${s//\\/_}"
    s="${s//:/_}"
    s="${s//\*/_}"
    s="${s//\?/_}"
    s="${s//\"/_}"
    s="${s//</_}"
    s="${s//>/_}"
    s="${s//|/_}"
    # Fold whitespace to single spaces, then drop remaining ASCII control chars.
    # Byte-based, so UTF-8 multibyte sequences pass through untouched.
    s="$(printf '%s' "$s" | tr -s '[:space:]' ' ')"
    s="$(printf '%s' "$s" | tr -d '\000-\037\177')"
    s="${s#"${s%%[![:space:].]*}"}"
    s="${s%"${s##*[![:space:].]}"}"
    [[ -n "$s" ]] || s="Unknown"
    printf '%s' "$s"
}

unique_output_path () {
    local base="$1"
    [[ ! -e "$base" ]] && { printf '%s\n' "$base"; return; }

    local dir file ext stem n=2
    dir="$(dirname "$base")"
    file="$(basename "$base")"
    ext="${file##*.}"
    stem="${file%.*}"
    while [[ -e "$dir/${stem}_$n.$ext" ]]; do
        n=$((n + 1))
    done
    printf '%s\n' "$dir/${stem}_$n.$ext"
}

file_path_structure () {
    local i_artist="$1" i_album="$2" i_title="$3" extension="$4"
    local outdir outfile base

    case "$filename_scheme" in
        normal)
            outdir="$session_output_directory/$(sanitize_component "$i_artist")/$(sanitize_component "$i_album")"
            outfile="$(sanitize_component "$i_title").$extension"
            ;;
        strict)
            outdir="$session_output_directory/$(sanitize_str "strict" "$i_artist")/$(sanitize_str "strict" "$i_album")"
            outfile="$(sanitize_str "strict" "$i_title").$extension"
            ;;
        strict-lc-nodir)
            outdir="$session_output_directory"
            outfile="$(sanitize_str "strict-lc" "$i_artist")_$(sanitize_str "strict-lc" "$i_album")_$(sanitize_str "strict-lc" "$i_title").$extension"
            ;;
        *)
            # Unreachable: filename_scheme is validated at startup.
            printf 'FATAL: invalid filename_scheme %s\n' "$filename_scheme" >&2
            exit 1
            ;;
    esac

    mkdir -p -- "$outdir"
    base="$outdir/$outfile"
    unique_output_path "$base"
}

###############################################################################
# MPRIS monitor (player-scoped)
###############################################################################

# Runs as a coproc. Emits "key -> value" lines parsed by process_dbus_line.
# If the player-scoped match rule is rejected, retries once unscoped.
get_dbusmessages () {
    local rule="$1"
    local fallback="path=/org/mpris/MediaPlayer2,member=PropertiesChanged"
    local expect_key="" expect_type="" line started=0 attempt=0

    while :; do
        attempt=$((attempt + 1))
        while IFS= read -r line; do
            started=1
            case "$line" in
                *'string "PlaybackStatus"'*)     expect_key="playbackstatus"; expect_type="string"; continue ;;
                *'string "mpris:trackid"'*)      expect_key="trackid";        expect_type="string"; continue ;;
                *'string "xesam:album"'*)        expect_key="album";          expect_type="string"; continue ;;
                *'string "xesam:albumArtist"'*)  expect_key="albumartist";    expect_type="string";       continue ;;
                *'string "xesam:artist"'*)       expect_key="artist";         expect_type="string_array";  continue ;;
                *'string "xesam:discNumber"'*)   expect_key="discnumber";     expect_type="int32";  continue ;;
                *'string "xesam:title"'*)        expect_key="title";          expect_type="string"; continue ;;
                *'string "xesam:trackNumber"'*)  expect_key="tracknumber";    expect_type="int32";  continue ;;
            esac

            [[ -z "$expect_key" ]] && continue

            if [[ "$expect_type" == "string" ]] && [[ $line == *'string "'* ]]; then
                printf '%s -> %s\n' "$expect_key" "$(cut -d '"' -f2 <<< "$line")"
                expect_key=""; expect_type=""
            elif [[ "$expect_type" == "string_array" ]] && [[ $line == *']'* ]]; then
                # End of the "xesam:artist" array (a bare "]" line) - stop
                # matching further elements, without emitting a bogus one.
                expect_key=""; expect_type=""
            elif [[ "$expect_type" == "string_array" ]] && [[ $line == *'string "'* ]]; then
                # One element of the "xesam:artist" array - unlike a scalar
                # "string" field, do NOT clear expect_key/expect_type here,
                # so every remaining element up to the closing "]" is also
                # emitted under the same "artist" key.
                printf '%s -> %s\n' "$expect_key" "$(cut -d '"' -f2 <<< "$line")"
            elif [[ "$expect_type" == "int32" ]] && [[ $line == *'int32 '* ]]; then
                # Value sits after the LAST "int32 " token, not at a fixed
                # field position - the "variant" prefix column width varies,
                # which previously made "awk '{print $2}'" print "int32"
                # itself instead of the number.
                printf '%s -> %s\n' "$expect_key" "${line##*int32 }"
                expect_key=""; expect_type=""
            fi
        done < <(dbus-monitor "$rule" 2>/dev/null)

        # dbus-monitor exited with no output at all -> the rule was rejected.
        # Retry once, unscoped (degraded: other MPRIS players may bleed in).
        if [[ $started -eq 0 && $attempt -eq 1 && "$rule" != "$fallback" ]]; then
            rule="$fallback"
            continue
        fi
        break
    done
}

###############################################################################
# Recording engine
###############################################################################

# stop_current_recording [quick|drain]
#   quick (default) - track change: stop capture and return immediately; the
#     encoder keeps running, sees EOF, finalizes its file and exits on its own.
#   drain           - session end: keep capturing for tail_drain_seconds, stop
#     capture, then wait for the encoder to finish writing the file.
stop_current_recording () {
    local mode="${1:-quick}"
    local fifo_dir="$record_fifo_dir"
    local old_encoder="$encoder_pid"
    local old_parec="$parec_pid"
    local waited=0 duration=""

    [[ "$stopping_recording" == "true" ]] && return
    stopping_recording=true

    if [[ "$mode" == "drain" && -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        sleep "$tail_drain_seconds"
    fi

    # Stop capture first so the encoder gets EOF and can flush a clean trailer.
    if [[ -n "$old_parec" ]] && kill -0 "$old_parec" 2>/dev/null; then
        kill "$old_parec" 2>/dev/null || true
    fi

    # Capture duration is measured here, right as capture actually stops - not
    # after the encoder-finalize wait below, which is not part of the audio.
    [[ -n "$record_log_file" ]] && duration=$((SECONDS - record_start_seconds))

    parec_pid=""
    encoder_pid=""
    record_fifo_dir=""

    if [[ "$mode" == "drain" && -n "$old_encoder" ]]; then
        while kill -0 "$old_encoder" 2>/dev/null && [[ $waited -lt 60 ]]; do
            sleep 0.05
            waited=$((waited + 1))
        done
        if kill -0 "$old_encoder" 2>/dev/null; then
            kill "$old_encoder" 2>/dev/null || true
        fi
    fi

    if [[ -n "$record_log_file" ]]; then
        log_recording "$record_log_artist" "$record_log_album" "$record_log_title" \
            "$record_log_tracknumber" "$record_log_discnumber" "$record_log_file" "$duration"
        record_log_file=""
    fi

    # Safe to remove now: an unlinked FIFO / log stays valid for a background
    # encoder still finalizing (its output file lives elsewhere).
    [[ -n "$fifo_dir" && -d "$fifo_dir" ]] && rm -rf "$fifo_dir"
    [[ -n "$record_error_log" && -f "$record_error_log" ]] && rm -f "$record_error_log"
    record_error_log=""

    stopping_recording=false
}

start_recording () {
    local i_artist="$1" i_album="$2" i_title="$3" i_albumartist="$4" i_tracknumber="$5" i_discnumber="$6"
    local outputfile="" record_fifo="" ext

    [[ -z "$i_title" || -z "$i_artist" ]] && return 1

    ext="m4a"
    [[ "$record_format" == "ogg" ]] && ext="oga"
    outputfile="$(file_path_structure "$i_artist" "$i_album" "$i_title" "$ext")"
    stop_current_recording

    if ! ensure_target_routed; then
        recording_failed=true; status_dirty=1
        log_line "could not route target sink to monitor output"
        return 1
    fi

    record_error_log="$(mktemp)"
    record_fifo_dir="$(mktemp -d)"
    record_fifo="$record_fifo_dir/pcm"
    if ! mkfifo "$record_fifo" 2>/dev/null; then
        log_line "could not create capture pipe under $record_fifo_dir"
        stop_current_recording
        return 1
    fi

    log_debug "encoder command: format=$record_format aac_profile=$aac_profile bitrate=${bitrate}k output=$outputfile"

    # OGG (unlike MP4/AAC) genuinely supports multiple ARTIST= comment
    # fields on one file. "oggenc --artist" doesn't add one, though - it
    # associates one artist per input FILE when repeated across a batch, not
    # multiple values on a single file - so every captured xesam:artist goes
    # through "-c ARTIST=..." instead, once per value. Falls back to
    # "--artist $i_artist" only if artist_all is empty (e.g. start_recording
    # invoked directly, bypassing the MPRIS parser, as tests do).
    local -a ogg_artist_args=()
    local _a
    for _a in "${artist_all[@]}"; do
        [[ -n "$_a" ]] && ogg_artist_args+=(-c "ARTIST=$_a")
    done
    [[ ${#ogg_artist_args[@]} -eq 0 ]] && ogg_artist_args=(--artist "$i_artist")

    # Encoder first (blocks on the pipe until parec writes), then capture.
    # Separately tracked processes let us stop capture first on shutdown so the
    # encoder can flush and finalize instead of being killed mid-stream.
    case "$record_format" in
        aac)
            # MP4's ©ART atom holds one string, not a repeatable list, so AAC
            # is tagged with only the first artist - same simplification as
            # the session log and file/folder naming.
            fdkaac -R -S -p "$aac_profile" --bitrate "${bitrate}k" --moov-before-mdat --afterburner 1 \
                --title "$i_title" --artist "$i_artist" --album "$i_album" --album-artist "$i_albumartist" \
                --track "$i_tracknumber" --disk "$i_discnumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        ogg)
            oggenc -b "$bitrate" --raw \
                --title "$i_title" "${ogg_artist_args[@]}" --album "$i_album" --tracknum "$i_tracknumber" \
                - -o "$outputfile" < "$record_fifo" 2>"$record_error_log" &
            encoder_pid=$!
            ;;
        *)
            recording_failed=true; status_dirty=1
            log_line "invalid record_format '$record_format'"
            stop_current_recording
            return 1
            ;;
    esac

    # Low capture latency keeps less audio stranded in the server buffer.
    parec -d "$nulloutput_name.monitor" --latency-msec=30 > "$record_fifo" 2>>"$record_error_log" &
    parec_pid=$!

    sleep 0.2
    if ! kill -0 "$parec_pid" 2>/dev/null || ! kill -0 "$encoder_pid" 2>/dev/null; then
        local err=""
        [[ -s "$record_error_log" ]] && err="$(tr '\n' ' ' < "$record_error_log")"
        kill "$parec_pid" "$encoder_pid" 2>/dev/null || true
        stop_current_recording
        [[ -n "$outputfile" ]] && rm -f "$outputfile"
        recording_failed=true; status_dirty=1
        log_line "recorder failed to start: ${err:-check codec dependencies and format settings}"
        return 1
    fi

    recording_failed=false; status_dirty=1
    tui_set "output" "$outputfile"

    # Logged once this recording actually stops (see stop_current_recording),
    # so the log entry can include the real capture duration.
    record_start_seconds=$SECONDS
    record_log_artist="$i_artist"
    record_log_album="$i_album"
    record_log_title="$i_title"
    record_log_tracknumber="$i_tracknumber"
    record_log_discnumber="$i_discnumber"
    record_log_file="$outputfile"
    return 0
}

maybe_start_recording () {
    local signature

    [[ "$playbackstatus" != "Playing" ]] && return
    [[ -z "$title" || -z "$artist" ]] && return

    signature="${trackid:-$artist|$album|$title}"
    [[ "$signature" == "$active_recording_signature" ]] && return

    if start_recording "$artist" "$album" "$title" "$albumartist" "$tracknumber" "$discnumber"; then
        active_recording_signature="$signature"
    fi
}

process_dbus_line () {
    local dbus_read="$1"

    # None of the branches below decide whether to (re)start recording -
    # that happens once per drain batch, in recording_main_loop, after every
    # currently-buffered line has been applied. A single MPRIS metadata
    # update emits its keys (album, artist, title, trackNumber, ...) as
    # several consecutive lines; deciding inline on whichever of title/
    # artist/album happens to complete the pair first raced ahead of
    # later keys in the same burst (trackNumber, in particular, is emitted
    # after title) and locked in a stale/empty value for the rest of the
    # track.
    case "$dbus_read" in
        'playbackstatus -> '*)
            playbackstatus="${dbus_read#playbackstatus -> }"
            status_dirty=1
            if [[ "$playbackstatus" == "Playing" ]]; then
                started_playing=true
            elif [[ "$started_playing" == "true" ]]; then
                # Any non-Playing state after playback began ends the session
                # (no half tracks; also where Spotify lands when a playlist
                # finishes). A pause before the first Playing is ignored.
                stop_current_recording "drain"
                active_recording_signature=""
                end_session
            fi
            ;;
        'trackid -> '*)
            trackid="${dbus_read#trackid -> }"
            if [[ "$trackid" != "$last_trackid" ]]; then
                last_trackid="$trackid"
                active_recording_signature=""
                title="" artist="" album="" albumartist="" tracknumber="" discnumber=""
                artist_all=()
                stop_current_recording
            fi
            ;;
        'title -> '*)       title="${dbus_read#title -> }";             tui_set "track" "$title" ;;
        'artist -> '*)
            local _artist_value="${dbus_read#artist -> }"
            # First xesam:artist element of this track becomes the scalar
            # "artist" (naming/log/AAC tag); every element - first included -
            # is also collected into artist_all (table display/OGG tags).
            [[ ${#artist_all[@]} -eq 0 ]] && artist="$_artist_value"
            artist_all+=("$_artist_value")
            tui_set "artist" "$(join_artist_list)"
            ;;
        'album -> '*)       album="${dbus_read#album -> }";             tui_set "album" "$album" ;;
        'albumartist -> '*) albumartist="${dbus_read#albumartist -> }" ;;
        'tracknumber -> '*) tracknumber="${dbus_read#tracknumber -> }"; tui_set "tracknumber" "$tracknumber" ;;
        'discnumber -> '*)  discnumber="${dbus_read#discnumber -> }";   tui_set "discnumber" "$discnumber" ;;
    esac
}

###############################################################################
# Recording screen
###############################################################################

# Every captured xesam:artist value, joined with "; " - used for the
# Metadata table and for OGG tagging (which writes them back out as separate
# ARTIST= comment fields). Naming, the session log, and the AAC tag use only
# the first value (the scalar "artist"), never this.
join_artist_list () {
    local joined="" a
    for a in "${artist_all[@]}"; do
        [[ -z "$joined" ]] && joined="$a" || joined="$joined; $a"
    done
    printf '%s' "$joined"
}

tui_set () {
    case "$1" in
        track)       tui_track="$2" ;;
        artist)      tui_artist="$2" ;;
        album)       tui_album="$2" ;;
        tracknumber) tui_tracknumber="$2" ;;
        discnumber)  tui_discnumber="$2" ;;
        output)      tui_output="$2" ;;
    esac
    status_dirty=1
    return 0
}

# tui_output made relative to the session folder (Artist/Album/File).
status_output_relpath () {
    local f="${tui_output:--}"
    if [[ "$f" == "-" || -z "$f" ]]; then
        printf -- '-'
    elif [[ -n "$session_output_directory" && "$f" == "$session_output_directory/"* ]]; then
        printf '%s' "${f#"$session_output_directory"/}"
    else
        printf '%s' "$f"
    fi
}

_kill_spinner () {
    if [[ -n "$_spinner_pid" ]]; then
        kill "$_spinner_pid" 2>/dev/null || true
        wait "$_spinner_pid" 2>/dev/null || true
    fi
    _spinner_pid=""
}

recording_screen_render () {
    [[ -t 1 ]] || return
    _kill_spinner

    local info meta status frame catcher_status="Recording"
    [[ "$recording_failed" == "true" ]] && catcher_status="Failed"

    info="$(ui_kv_table 'Info' '' \
        'Output Folder' "$(clip_text "${output_directory:--}")" \
        'Session Name' "$(clip_text "${session_name:--}")" \
        'Config File' "$(clip_text "$config_path")" \
        'Audio Sink' "${source_sink_index:--}")"

    meta="$(ui_kv_table 'Metadata' '' \
        'Artist' "$(clip_text "${tui_artist:--}")" \
        'Album' "$(clip_text "${tui_album:--}")" \
        'Track' "$(clip_text "${tui_track:--}")" \
        'Track No.' "$(clip_text "${tui_tracknumber:--}")" \
        'Disc No.' "$(clip_text "${tui_discnumber:--}")" \
        'Output File' "$(clip_text "$(status_output_relpath)")")"

    # Playback Status is printed exactly as MPRIS reports it (Playing/Paused/
    # Stopped/...), with no relabelling.
    status="$(ui_kv_table 'Status' '' \
        'Catcher Status' "$catcher_status" \
        'Playback Status' "$playbackstatus")"

    printf -v frame '%s\n%s\n%s\n%s\n' \
        "$(ui_title_row 'Recording')" "$info" "$meta" "$status"

    paint_frame "$frame"
    ui_gap

    gum spin --spinner dot --title "${catcher_status}..." -- sleep 999999 &
    _spinner_pid=$!
}

end_session () {
    session_ended=true
    should_exit=1
}

recording_main_loop () {
    # Snapshot the coproc fd: bash may unset the DBUS_MONITOR array once the
    # coprocess exits, and "set -u" would then abort on ${DBUS_MONITOR[0]}.
    local dbus_fd="${DBUS_MONITOR[0]}"
    local dbus_read last_liveness=$SECONDS

    while [[ $should_exit -eq 0 ]]; do
        if ! kill -0 "$dbus_monitor_pid" 2>/dev/null; then
            exit_note="loopcatcher: dbus-monitor ended, session stopped."
            break
        fi

        # Drain every line already buffered before repainting, so a metadata
        # burst (trackid + title + artist + album) collapses into ONE repaint.
        local dbus_activity=0
        while IFS= read -r -t 0.2 -u "$dbus_fd" dbus_read 2>/dev/null; do
            process_dbus_line "$dbus_read"
            dbus_activity=1
            [[ $should_exit -eq 0 ]] || break
        done

        # Decide once per drain batch, after every buffered key of the burst
        # has been applied - not per key line - so a field emitted later in
        # the same MPRIS update (trackNumber comes after title) is already
        # in place before recording is (re)started.
        [[ $dbus_activity -eq 1 && $should_exit -eq 0 ]] && maybe_start_recording

        # Catch a player that quit outright (no Paused/Stopped signal reaches
        # the still-running dbus-monitor). Checked on a ~2s wall-clock timer.
        if [[ $should_exit -eq 0 && $(( SECONDS - last_liveness )) -ge 2 ]]; then
            last_liveness=$SECONDS
            poll_player_liveness
        fi

        # One repaint per tick, only when something changed.
        if [[ $status_dirty -eq 1 && $should_exit -eq 0 ]]; then
            status_dirty=0
            recording_screen_render
        fi
    done
}

###############################################################################
# Finish screen
###############################################################################

finish_screen () {
    render_page_plain "Recording Finished" \
        "$(ui_notify "Recording session finished")" \
        "$(ui_box "Your recordings are saved in:" "" "$session_output_directory")"
    ui_gap
    printf '%s\n' "$(gum style --bold -- 'Press any key to exit.')"
    read -rsn1 || true
}

###############################################################################
# Lifecycle
###############################################################################

remove_null_sink () {
    local module_id
    # Unload every null sink that carries our exact name - the one we loaded
    # plus any leftover from a previously crashed run.
    while IFS= read -r module_id; do
        [[ -n "$module_id" ]] || continue
        pactl unload-module "$module_id" 2>/dev/null || true
    done < <(_null_sink_module_ids)
}

cleanup () {
    _kill_spinner
    # "drain" so a manual quit mid-track still finalizes the current file.
    stop_current_recording "drain"
    if [[ -n "$dbus_monitor_pid" ]] && kill -0 "$dbus_monitor_pid" 2>/dev/null; then
        kill "$dbus_monitor_pid" 2>/dev/null || true
    fi
    remove_null_sink
    screen_leave
    printf '\033[0m'
    [[ -t 1 ]] && ui_clear
    [[ -n "$exit_note" ]] && printf '%s\n' "$exit_note" >&2
    return 0
}

###############################################################################
# CLI
###############################################################################

get_options () {
    local usage="loopcatcher v${SCRIPT_VERSION}

Usage: ${0##*/} [options]

Behavior:
  - The Welcome screen shows the current (or default) configuration; accept it
    or open the Configuration screen to change it.
  - Session name is asked interactively (prefilled with a timestamp; just press
    Enter). Provide --session to skip the prompt.
  - Output goes to: output-directory/session-name
  - The Recording Wizard walks you through creating the audio sink, pausing,
    then starting playback to begin recording automatically.
  - The session ends automatically when playback pauses, stops, or the player
    quits.

Options:
  --debug                   Set log_level to 2 (adds encoder diagnostics to the session log)
  --output <dir>            Output directory
  --session <name>          Session name (skips the prompt)
  --format <format>         Record format: aac or ogg
  --aac-profile <id>        AAC profile (aac only)
  --bitrate <kbps>          Bitrate target
  --scheme <scheme>         Filename scheme: normal, strict, strict-lc-nodir
  --config <path>           Override config file path
  --help                    Show help
  --version                 Show version
"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)          log_level=2; shift ;;
            --help)           show_help=true; shift ;;
            --version)        show_version=true; shift ;;
            --output)         [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; output_directory="$2"; shift 2 ;;
            --output=*)       output_directory="${1#*=}"; shift ;;
            --session)        [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; session_name="$2"; shift 2 ;;
            --session=*)      session_name="${1#*=}"; shift ;;
            --aac-profile)    [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; aac_profile="$2"; shift 2 ;;
            --aac-profile=*)  aac_profile="${1#*=}"; shift ;;
            --bitrate)        [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; bitrate="$2"; shift 2 ;;
            --bitrate=*)      bitrate="${1#*=}"; shift ;;
            --config)         [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }; config_path="$2"; config_dir="$(dirname "$config_path")"; shift 2 ;;
            --config=*)       config_path="${1#*=}"; config_dir="$(dirname "$config_path")"; shift ;;
            --format)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                record_format="$2"
                case "$record_format" in aac|ogg) ;; *) printf 'Invalid --format value: %s\n' "$record_format"; exit 1 ;; esac
                shift 2
                ;;
            --format=*)
                record_format="${1#*=}"
                case "$record_format" in aac|ogg) ;; *) printf 'Invalid --format value: %s\n' "$record_format"; exit 1 ;; esac
                shift
                ;;
            --scheme)
                [[ $# -lt 2 ]] && { printf '%s\n' "$usage"; exit 1; }
                filename_scheme="$2"
                case "$filename_scheme" in normal|strict|strict-lc-nodir) ;; *) printf 'Invalid --scheme value: %s\n' "$filename_scheme"; exit 1 ;; esac
                shift 2
                ;;
            --scheme=*)
                filename_scheme="${1#*=}"
                case "$filename_scheme" in normal|strict|strict-lc-nodir) ;; *) printf 'Invalid --scheme value: %s\n' "$filename_scheme"; exit 1 ;; esac
                shift
                ;;
            --) shift ;;
            -*) printf '%s\n' "$usage"; exit 1 ;;
            *)  printf 'Unknown argument: %s\n\n' "$1"; printf '%s\n' "$usage"; exit 1 ;;
        esac
    done

    [[ "$show_help" == "true" ]] && { printf '%s\n' "$usage"; exit 0; }
    [[ "$show_version" == "true" ]] && { printf 'loopcatcher version %s\n' "$SCRIPT_VERSION"; exit 0; }
    return 0
}

###############################################################################
# Internal worker used by the Recording Wizard's spinner (gum spin wraps this
# process so the wait animates with a real gum spinner and Ctrl+C cancels it
# like any other foreground command).
###############################################################################

_internal_wait () {
    local kind="$1"; shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config) config_path="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    load_config
    case "$kind" in
        sink)    until get_target_sink_index; do sleep 1; done ;;
        stopped) until _playback_is_stopped;  do sleep 1; done ;;
        playing) until _playback_is_playing;  do sleep 1; done ;;
        *)       return 1 ;;
    esac
}

###############################################################################
# Main
###############################################################################

main () {
    get_options "$@"
    check_dependencies
    require_tty "loopcatcher"

    ensure_config_dir
    load_config
    get_options "$@"          # CLI flags win over the config file
    validate_settings
    check_encoder_dependency

    welcome_screen
    initialize_output_directory
    session_name_screen
    check_audio_server
    init_session_log

    trap cleanup EXIT
    trap 'should_exit=1' INT TERM

    recording_wizard

    create_null_audio_output
    move_target_output

    # The Recording screen is only ever shown while a session is underway;
    # Catcher Status starts "Recording" (recording_failed defaults false) - see
    # "Global state" above.
    screen_enter
    trap 'status_dirty=1' WINCH

    status_dirty=0
    recording_screen_render

    recording_main_loop

    _kill_spinner
    [[ "$session_ended" == "true" ]] && finish_screen
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ "${1:-}" == "--internal-wait" ]]; then
        shift
        _internal_wait "$@"
        exit $?
    fi
    main "$@"
fi
